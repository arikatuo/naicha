.section-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 900;
}

.subtitle {
  color: #7f7168;
  font-size: 24rpx;
  line-height: 1.5;
}

.drink-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.drink-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #fff3e2;
  text-align: left;
}

.drink-name {
  font-size: 32rpx;
  font-weight: 800;
}

.tag-row,
.segmented,
.readonly-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag,
.readonly-tag,
.option {
  border-radius: 999rpx;
  background: #ead6c1;
  color: #5a3a28;
  font-size: 24rpx;
  padding: 10rpx 18rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(47, 36, 29, 0.36);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 36rpx 32rpx 48rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #fffaf3;
}

.sheet-title {
  font-size: 38rpx;
  font-weight: 900;
}

.label {
  color: #6f5d51;
  font-size: 24rpx;
  font-weight: 700;
}

.option-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.option.active {
  background: #5b3926;
  color: #fffaf3;
}
