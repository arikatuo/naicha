.section-head {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 34rpx;
}

.eyebrow {
  width: fit-content;
  border-radius: 999rpx;
  background: #f6e5ce;
  color: #8b5f3f;
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 18rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 900;
}

.subtitle {
  color: #7f7168;
  font-size: 24rpx;
  line-height: 1.5;
}

.drink-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.drink-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  border: 0;
  border-radius: 26rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 32rpx rgba(88, 58, 36, 0.08);
  padding: 28rpx;
  text-align: left;
}

.drink-card::after {
  border: 0;
}

.drink-card:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.drink-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 24rpx;
}

.drink-name {
  font-size: 32rpx;
  font-weight: 900;
}

.drink-action {
  flex: 0 0 auto;
  border-radius: 999rpx;
  background: #f4a261;
  color: #fff8ec;
  font-size: 22rpx;
  font-weight: 800;
  padding: 10rpx 18rpx;
}

.tag-row,
.segmented,
.readonly-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag,
.readonly-tag,
.option {
  border-radius: 999rpx;
  background: #f6e5ce;
  color: #5a3a28;
  font-size: 24rpx;
  padding: 10rpx 18rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(47, 36, 29, 0.46);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  max-height: 82vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx 54rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff8ec;
  box-shadow: 0 -20rpx 60rpx rgba(47, 36, 29, 0.18);
}

.sheet-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sheet-kicker {
  color: #8b5f3f;
  font-size: 24rpx;
  font-weight: 800;
}

.sheet-title {
  font-size: 40rpx;
  font-weight: 900;
}

.sheet-subtitle {
  color: #77695f;
  font-size: 24rpx;
}

.label {
  color: #6f5d51;
  font-size: 24rpx;
  font-weight: 700;
}

.option-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.option.active {
  background: #6b3f2a;
  color: #fff8ec;
}

.sheet-button {
  margin-top: 6rpx;
}
