.drinks-page {
  padding-bottom: 48rpx;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
}

.subtitle,
.empty-copy,
.helper {
  color: #6f5d51;
  font-size: 24rpx;
  line-height: 1.5;
}

.drink-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.drink-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
  width: 100%;
  min-height: 224rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 22rpx 20rpx;
  border: 1rpx solid rgba(185, 118, 78, 0.14);
  border-radius: 28rpx;
  background: #fff9f0;
  color: #2d1f18;
  text-align: left;
  box-shadow: 0 16rpx 28rpx rgba(101, 62, 39, 0.08);
  transition: transform 180ms ease-out, box-shadow 180ms ease-out;
}

.drink-card::after,
.option::after,
.sheet-close::after,
.empty-button::after {
  border: 0;
}

.drink-card:active {
  background: #EDE8E0;
  transform: scale(0.97);
  box-shadow: 0 6rpx 14rpx rgba(101, 62, 39, 0.06);
  transition: 80ms ease-out;
}

.drink-card-head {
  display: flex;
  justify-content: flex-start;
}

.drink-icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 160rpx;
  border: 1rpx solid rgba(185, 118, 78, 0.14);
  border-radius: 24rpx;
  background: #fff2dd;
}

.drink-icon {
  max-width: 120rpx;
  max-height: 120rpx;
  width: auto;
  height: auto;
  object-fit: contain;
}

.drink-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  min-width: 0;
}

.drink-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #2d1f18;
  line-height: 1.24;
  margin-bottom: 12rpx;
}

.tag-row,
.segmented,
.readonly-values {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.readonly-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 64rpx;
}

.readonly-heading {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
}

.readonly-values {
  flex: 1;
  min-width: 0;
}

.tag,
.readonly-tag {
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 1.2;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(185, 118, 78, 0.14);
  background: #F1EFE8;
  color: #6f6862;
}

.tag-fruit {
  background: #EAF3DE;
  color: #3B6D11;
  border-color: rgba(59, 109, 17, 0.14);
}

.tag-milktea {
  background: #FAEEDA;
  color: #854F0B;
  border-color: rgba(133, 79, 11, 0.14);
}

.tag-fresh {
  background: #E6F1FB;
  color: #185FA5;
  border-color: rgba(24, 95, 165, 0.14);
}

.tag-toppings {
  background: #FAECE7;
  color: #993C1D;
  border-color: rgba(153, 60, 29, 0.14);
}

.option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid rgba(185, 118, 78, 0.14);
  border-radius: 999rpx;
  background: #fff3e0;
  color: #5a3a28;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(45, 31, 24, 0.36);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  height: 82vh;
  max-height: 82vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 0;
  border-radius: 40rpx 40rpx 0 0;
  background: #fff8ef;
  box-shadow: 0 -18rpx 48rpx rgba(45, 31, 24, 0.16);
  overflow: hidden;
}

.sheet-head {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  align-items: flex-start;
  padding-right: 108rpx;
  padding-bottom: 16rpx;
}

.sheet-head-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.sheet-close {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 0 4rpx;
  border: 1rpx solid rgba(185, 118, 78, 0.16);
  border-radius: 999rpx;
  background: #fff9f0;
  color: #6b4c3d;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
  box-shadow: 0 6rpx 14rpx rgba(95, 61, 49, 0.06);
}

.sheet-kicker {
  color: #8b4f3b;
  font-size: 24rpx;
  font-weight: 800;
}

.sheet-title {
  font-size: 40rpx;
  font-weight: 800;
}

.sheet-subtitle {
  color: #6f5d51;
  font-size: 24rpx;
}

.group-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}

.label {
  color: #6f5d51;
  font-size: 24rpx;
  font-weight: 800;
}

.option-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
}

.sheet-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 8rpx 0 calc(190rpx + env(safe-area-inset-bottom));
}

.sheet-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  box-sizing: border-box;
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(185, 118, 78, 0.1);
  background: linear-gradient(180deg, rgba(255, 248, 239, 0), #fff8ef 28%);
}

.option.active {
  border-color: #b9473d;
  background: #b9473d;
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(185, 71, 61, 0.18);
}

.sheet-button {
  width: auto;
  max-width: none;
  align-self: stretch;
  justify-self: stretch;
  margin: 0;
  min-height: 96rpx;
}

.tiny-clay {
  width: 48rpx;
  height: 48rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  align-items: flex-start;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(185, 118, 78, 0.12);
  box-shadow: 0 14rpx 28rpx rgba(101, 62, 39, 0.06);
}

.empty-title {
  color: #2d1f18;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
}

.empty-button {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
}

.empty-button.secondary {
  border: 1rpx solid rgba(185, 118, 78, 0.16);
  border-radius: 999rpx;
  background: #fff4e5;
  color: #6f5d51;
  font-weight: 700;
  box-shadow: none;
}
