.drinks-page { padding-top: 16rpx; padding-bottom: 48rpx; }

.subtitle, .empty-copy, .helper { color: var(--text-2); font-size: var(--fs-cap); line-height: 1.5; }

/* ---------- 筛选与排序 ---------- */
.list-tools { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 20rpx; }
.filter-scroll { margin: 0 -32rpx; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 12rpx; padding: 0 32rpx; }
.filter-chip, .sort-chip { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; min-height: 64rpx; box-sizing: border-box; padding: 0 26rpx; border: 2rpx solid var(--line); border-radius: var(--r-pill); background: var(--surface); color: var(--text-2); font-size: 25rpx; line-height: 1; }
.sort-chip { align-self: flex-start; }
.filter-chip.active, .sort-chip.active { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); font-weight: var(--fw-strong); }

/* ---------- 饮品列表：紧凑单列，一屏能看 7 到 8 杯 ---------- */
.drink-list { display: flex; flex-direction: column; gap: 12rpx; }

.drink-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 24rpx 16rpx 16rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--surface);
  color: var(--text);
  text-align: left;
  box-shadow: var(--shadow-card);
}

.drink-icon-shell { display: flex; flex: 0 0 96rpx; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border-radius: var(--r-sm); background: var(--bg); }
.drink-icon { display: block; width: 76rpx; height: 76rpx; }
.drink-content { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: 8rpx; min-width: 0; }
.drink-name { max-width: 100%; overflow: hidden; font-size: 28rpx; font-weight: var(--fw-strong); color: var(--text); line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.drink-kcal-box { display: flex; flex: 0 0 auto; flex-direction: column; align-items: flex-end; gap: 2rpx; }
.drink-kcal-number { color: var(--primary); font-size: 36rpx; font-weight: var(--fw-strong); line-height: 1; }
.drink-kcal-unit { color: var(--text-3); font-size: 21rpx; line-height: 1.2; }

.tag-row, .segmented, .readonly-values { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag, .readonly-tag { padding: 6rpx 14rpx; border-radius: var(--r-pill); background: var(--bg); color: var(--text-2); font-size: 22rpx; line-height: 1.3; }
.tag-fruit { background: #edf4e3; color: #4b6b2a; }
.tag-milktea { background: var(--surface-soft); color: #8a5a34; }
.tag-fresh { background: #e8f1f8; color: #35648f; }
.tag-toppings { background: var(--primary-soft); color: #a5463c; }

/* ---------- 配置浮层 ---------- */
.sheet-mask { position: fixed; inset: 0; background: rgba(45, 31, 24, 0.4); }

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  height: 84vh;
  max-height: 84vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 0;
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  background: var(--bg);
  overflow: hidden;
}

.sheet-head { position: relative; display: flex; flex: 0 0 auto; align-items: flex-start; padding-right: 108rpx; padding-bottom: 20rpx; }
.sheet-head-copy { display: flex; flex: 1; flex-direction: column; gap: 6rpx; min-width: 0; }
.sheet-kicker { color: var(--primary); font-size: var(--fs-cap); font-weight: var(--fw-strong); }
.sheet-title { font-size: 40rpx; font-weight: var(--fw-strong); line-height: 1.2; }
.sheet-subtitle { color: var(--text-2); font-size: 24rpx; }

.sheet-close {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 0 4rpx;
  border: 0;
  border-radius: var(--r-pill);
  background: var(--surface-soft);
  color: var(--text-2);
  font-size: 40rpx;
  line-height: 1;
}

.sheet-scroll { flex: 1; min-height: 0; }
.sheet-body { display: flex; flex-direction: column; gap: 32rpx; padding: 8rpx 0 calc(280rpx + env(safe-area-inset-bottom)); }

.group-label-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; flex-wrap: wrap; }
.label { color: var(--text-2); font-size: var(--fs-cap); font-weight: var(--fw-strong); }
.option-group { display: flex; flex-direction: column; gap: 16rpx; }

.readonly-row { display: flex; align-items: center; gap: 14rpx; min-height: 64rpx; }
.readonly-heading { display: flex; flex: 0 0 auto; align-items: center; gap: 8rpx; }
.readonly-values { flex: 1; min-width: 0; }
.tiny-clay { width: 40rpx; height: 40rpx; }

/* 选项：选中是淡红底加红字红边，不再是整块实心红 */
.option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 80rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-pill);
  background: var(--surface);
  color: var(--text);
  font-size: 26rpx;
  line-height: 1.25;
  text-align: center;
}
.option.active { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); font-weight: var(--fw-strong); }
.option-check { font-size: 24rpx; font-weight: var(--fw-strong); }
.option-kcal { color: var(--text-2); font-size: 24rpx; }
.option.active .option-kcal { color: var(--primary); }

.topping-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx 16rpx; width: 100%; }
.topping-option { width: 100%; min-width: 0; padding: 0 12rpx; }

/* 底部：实时热量 + 主操作 + 次操作 */
.sheet-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  gap: 12rpx;
  box-sizing: border-box;
  padding: 20rpx 32rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--surface);
}
.live-row { display: flex; align-items: baseline; gap: 10rpx; }
.live-label { color: var(--text-2); font-size: 26rpx; }
.live-number { color: var(--text); font-size: 56rpx; font-weight: var(--fw-strong); line-height: 1.1; }
.live-unit { color: var(--text-2); font-size: 26rpx; }
.live-badge { margin-left: auto; padding: 4rpx 14rpx; border-radius: var(--r-pill); background: var(--surface-soft); color: var(--text-2); font-size: 22rpx; }

.sheet-actions { display: flex; gap: 16rpx; }
.sheet-button { flex: 1.3; min-height: 92rpx; }
.sheet-quick { flex: 1; min-height: 92rpx; color: var(--primary); }

/* ---------- 空状态 ---------- */
.empty-state { display: flex; flex-direction: column; gap: 18rpx; align-items: flex-start; padding: 32rpx 28rpx; }
.empty-title { color: var(--text); font-size: 34rpx; font-weight: var(--fw-strong); line-height: 1.3; }
.empty-actions { display: flex; flex-direction: column; gap: 12rpx; width: 100%; }
.empty-button { width: 100%; min-height: 88rpx; margin: 0; }
.empty-button.secondary { border: 2rpx solid var(--line); border-radius: var(--r-pill); background: var(--surface); color: var(--text-2); font-weight: var(--fw-strong); box-shadow: none; }
