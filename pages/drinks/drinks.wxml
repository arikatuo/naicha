<view class="page drinks-page">
  <view wx:if="{{hasContent}}">
    <view class="list-tools">
      <scroll-view wx:if="{{filters.length}}" class="filter-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
        <view class="filter-row">
          <view role="button" wx:for="{{filters}}" wx:key="id" class="filter-chip {{activeFilter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectFilter">{{item.name}}</view>
        </view>
      </scroll-view>
      <view role="button" class="sort-chip {{sortByCalories ? 'active' : ''}}" bindtap="toggleSort">热量从低到高</view>
    </view>

    <view class="drink-list">
      <view role="button"
        wx:for="{{visibleDrinks}}"
        wx:key="id"
        class="drink-card"
        data-id="{{item.id}}"
        bindtap="openDrink"
        aria-label="打开 {{item.displayName}} 配置"
      >
        <view class="drink-icon-shell">
          <image class="drink-icon" src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <view class="drink-content">
          <text class="drink-name">{{item.displayName}}</text>
          <view class="tag-row">
            <text wx:for="{{item.displayTags}}" wx:key="id" class="tag {{item.tagClass}}">{{item.name}}</text>
          </view>
        </view>
        <view class="drink-kcal-box"><text class="drink-kcal-number">{{item.defaultCalories}}</text><text class="drink-kcal-unit">kcal</text></view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-title">{{emptyTitle}}</text>
    <text class="empty-copy">{{emptyMessage}}</text>
    <view class="empty-actions">
      <view role="button" class="button-primary empty-button" bindtap="reloadContent">重试一下</view>
      <view role="button" class="empty-button secondary" bindtap="backToBrands">返回品牌列表</view>
    </view>
  </view>

  <view wx:if="{{panelOpen}}" class="sheet-mask" bindtap="closePanel"></view>
  <view wx:if="{{panelOpen}}" class="sheet">
    <view class="sheet-head">
      <view class="sheet-head-copy">
        <text class="sheet-kicker">{{brand.name}}</text>
        <text class="sheet-title">{{selectedDrink.displayName}}</text>
        <text class="sheet-subtitle">调一调杯型、甜度和加料，热量会实时变化。</text>
      </view>
      <view role="button" class="sheet-close" bindtap="closePanel" aria-label="关闭饮品配置">×</view>
    </view>

    <scroll-view class="sheet-scroll" scroll-y="true">
      <view class="sheet-body">
        <view wx:if="{{defaultToppings.length}}" class="readonly-row">
          <view class="readonly-heading">
            <text class="label">本身含有</text>
            <image class="tiny-clay" src="/assets/icons/toppings.png" mode="aspectFit" aria-hidden="true"></image>
          </view>
          <view class="readonly-values">
            <text wx:for="{{defaultToppings}}" wx:key="id" class="readonly-tag">{{item.name}}</text>
          </view>
        </view>

        <view wx:if="{{selectedDrink.availableSizes.length > 1}}" class="option-group">
          <text class="label">杯型</text>
          <view class="segmented">
            <view role="button"
              wx:for="{{sizeOptions}}"
              wx:key="id"
              class="option {{item.selected ? 'active' : ''}}"
              data-id="{{item.id}}"
              bindtap="selectSize"
              aria-label="杯型 {{item.name}}"
              aria-checked="{{item.selected}}"
            >
              <text wx:if="{{item.selected}}" class="option-check">✓</text>{{item.name}}
            </view>
          </view>
        </view>

        <view wx:if="{{selectedDrink.sweetnessAdjustable}}" class="option-group">
          <text class="label">甜度</text>
          <view class="segmented wrap">
            <view role="button"
              wx:for="{{sweetnessLevels}}"
              wx:key="id"
              class="option {{selectedSweetnessId === item.id ? 'active' : ''}}"
              data-id="{{item.id}}"
              bindtap="selectSweetness"
              aria-label="甜度 {{item.name}}"
              aria-checked="{{selectedSweetnessId === item.id}}"
            >
              <text wx:if="{{selectedSweetnessId === item.id}}" class="option-check">✓</text>{{item.name}}
            </view>
          </view>
        </view>

        <view class="option-group">
          <view class="group-label-row">
            <text class="label">额外加料 {{selectedExtraToppingCount}}/3</text>
            <text class="helper">最多额外选 3 种</text>
          </view>
          <view class="segmented topping-grid">
            <view role="button"
              wx:for="{{toppingOptions}}"
              wx:key="id"
              class="option topping-option {{item.selected ? 'active' : ''}}"
              data-id="{{item.id}}"
              bindtap="toggleExtraTopping"
              aria-label="额外加料 {{item.name}}，增加{{item.calories}}千卡"
              aria-checked="{{item.selected}}"
            >
              <text wx:if="{{item.selected}}" class="option-check">✓</text><text class="option-name">{{item.name}}</text><text class="option-kcal">+{{item.calories}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="sheet-footer">
      <view class="live-row" aria-live="polite">
        <text class="live-label">这一杯约</text>
        <text class="live-number">{{liveCalories}}</text>
        <text class="live-unit">kcal</text>
        <text class="live-badge">估算</text>
      </view>
      <view class="sheet-actions">
        <view role="button" class="button-secondary sheet-quick" bindtap="saveNow">直接记到{{recordDateLabel}}</view>
        <view role="button" class="button-primary sheet-button" bindtap="calculate">看看等于什么</view>
      </view>
    </view>
  </view>
</view>