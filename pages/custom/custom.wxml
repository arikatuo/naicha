<view class="page custom-page">
  <view class="custom-intro">
    <image class="topping-toy" src="/assets/icons/toppings.png" mode="aspectFit"></image>
    <text class="subtitle">选基底、杯型、甜度和小料，热量实时更新。</text>
  </view>

  <view class="builder-surface surface">
    <view class="builder-group">
      <view class="group-head">
        <text class="step-dot">1</text>
        <text class="label">先选基底</text>
      </view>
      <text class="group-caption">奶茶果茶</text>
      <view class="option-grid chips">
        <view role="button"
          wx:for="{{teaBases}}"
          wx:key="id"
          class="option {{selectedBaseId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectBase"
          aria-label="基底 {{item.name}}"
          aria-checked="{{selectedBaseId === item.id}}"
        >
          <text wx:if="{{selectedBaseId === item.id}}" class="option-check">✓</text>{{item.name}}
        </view>
      </view>
      <text class="group-caption">咖啡</text>
      <view class="option-grid chips">
        <view role="button"
          wx:for="{{coffeeBases}}"
          wx:key="id"
          class="option {{selectedBaseId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectBase"
          aria-label="基底 {{item.name}}"
          aria-checked="{{selectedBaseId === item.id}}"
        >
          <text wx:if="{{selectedBaseId === item.id}}" class="option-check">✓</text>{{item.name}}
        </view>
      </view>
    </view>

    <view class="builder-group">
      <view class="group-head">
        <text class="step-dot">2</text>
        <text class="label">杯型</text>
      </view>
      <view class="option-grid two">
        <view role="button"
          wx:for="{{cupSizes}}"
          wx:key="id"
          class="option {{selectedSizeId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectSize"
          aria-label="杯型 {{item.name}}"
          aria-checked="{{selectedSizeId === item.id}}"
        >
          <text wx:if="{{selectedSizeId === item.id}}" class="option-check">✓</text>{{item.name}}
        </view>
      </view>
    </view>

    <view wx:if="{{sweetnessVisible}}" class="builder-group">
      <view class="group-head">
        <text class="step-dot">3</text>
        <text class="label">甜度</text>
      </view>
      <view class="option-grid">
        <view role="button"
          wx:for="{{sweetnessLevels}}"
          wx:key="id"
          class="option {{selectedSweetnessId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectSweetness"
          aria-label="甜度 {{item.name}}"
          aria-checked="{{selectedSweetnessId === item.id}}"
        >
          <text wx:if="{{selectedSweetnessId === item.id}}" class="option-check">✓</text>{{item.name}}
        </view>
      </view>
    </view>

    <view class="builder-group">
      <view class="group-head">
        <text class="step-dot">{{toppingStep}}</text>
        <text class="label">{{selectedBaseId === 'americano' || selectedBaseId === 'coffee-latte' ? '加点咖啡配料' : '加点小料'}} {{selectedToppingCount}}/4</text>
      </view>
      <text class="group-help">最多选 4 种，按你平时的搭配来。</text>
      <view class="option-grid">
        <view role="button"
          wx:for="{{visibleToppingOptions}}"
          wx:key="id"
          class="option {{item.selected ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="toggleTopping"
          aria-label="小料 {{item.name}}"
          aria-checked="{{item.selected}}"
        >
          <text wx:if="{{item.selected}}" class="option-check">✓</text><text class="option-name">{{item.name}}</text><text class="option-kcal">+{{item.calories}}</text>
        </view>
      </view>
      <view wx:if="{{canCollapseToppings}}" role="button" class="more-toggle" bindtap="toggleAllToppings">{{showAllToppings ? '收起' : '展开更多 ' + hiddenToppingCount + ' 种'}}</view>
    </view>
  </view>

  <view class="submit-bar">
    <view class="live-row" aria-live="polite">
      <text class="live-label">这一杯约</text>
      <text class="live-number">{{liveCalories}}</text>
      <text class="live-unit">kcal</text>
      <text class="live-badge">估算</text>
    </view>
    <view class="submit-actions">
      <view role="button" class="button-secondary submit-quick" bindtap="saveNow">直接记到{{recordDateLabel}}</view>
      <view role="button" class="button-primary submit" bindtap="calculate">看看等于什么</view>
    </view>
  </view>
</view>
