.section-head,
.option-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 900;
}

.subtitle,
.label {
  color: #7f7168;
  font-size: 24rpx;
}

.label {
  font-weight: 800;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.option-grid.two {
  grid-template-columns: repeat(2, 1fr);
}

.option {
  min-height: 72rpx;
  border-radius: 999rpx;
  background: #f0dfcc;
  color: #4a3324;
  font-size: 24rpx;
}

.option.active {
  background: #5b3926;
  color: #fffaf3;
}

.submit {
  margin-top: 24rpx;
}
