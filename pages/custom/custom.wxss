.custom-page { padding-top: 16rpx; padding-bottom: calc(260rpx + env(safe-area-inset-bottom)); }

.custom-intro { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; padding: 0 4rpx; }
.topping-toy { flex: 0 0 96rpx; width: 96rpx; height: 96rpx; }
.subtitle, .group-help { color: var(--text-2); font-size: var(--fs-cap); line-height: 1.5; }

.builder-surface { display: flex; flex-direction: column; padding: 32rpx 28rpx; }
.builder-group { display: flex; flex-direction: column; gap: 16rpx; }
.builder-group + .builder-group { margin-top: 32rpx; padding-top: 32rpx; border-top: 1rpx solid var(--line); }

.group-head { display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; }
.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--r-pill);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--fs-cap);
  font-weight: var(--fw-strong);
}
.label { color: var(--text); font-size: 28rpx; font-weight: var(--fw-strong); }

.group-caption { color: var(--text-3); font-size: 22rpx; line-height: 1.4; }
.group-caption + .option-grid + .group-caption { margin-top: 8rpx; }
.more-toggle { display: flex; align-items: center; justify-content: center; min-height: 80rpx; margin-top: 4rpx; color: var(--primary); font-size: 26rpx; font-weight: var(--fw-strong); }

.option-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; width: 100%; box-sizing: border-box; }
.option-grid.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.option-grid.chips .option { width: auto; flex: 0 0 auto; padding: 0 30rpx; }
.option-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }

/* 选项：与饮品浮层一致，选中是淡红底加红字红边 */
.option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-height: 80rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 18rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-pill);
  background: var(--surface);
  color: var(--text);
  font-size: 26rpx;
  line-height: 1.2;
  text-align: center;
  overflow: hidden;
}
.option.active { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); font-weight: var(--fw-strong); }
.option-check { font-size: 24rpx; font-weight: var(--fw-strong); }
.option-kcal { color: var(--text-2); font-size: 24rpx; }
.option.active .option-kcal { color: var(--primary); }

/* 底部：实时热量 + 主操作 + 次操作 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  gap: 12rpx;
  padding: 20rpx 32rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--surface);
}
.live-row { display: flex; align-items: baseline; gap: 10rpx; }
.live-label { color: var(--text-2); font-size: 26rpx; }
.live-number { color: var(--text); font-size: 56rpx; font-weight: var(--fw-strong); line-height: 1.1; }
.live-unit { color: var(--text-2); font-size: 26rpx; }
.live-badge { margin-left: auto; padding: 4rpx 14rpx; border-radius: var(--r-pill); background: var(--surface-soft); color: var(--text-2); font-size: 22rpx; }
.submit-actions { display: flex; gap: 16rpx; }
.submit { flex: 1.3; min-height: 92rpx; }
.submit-quick { flex: 1; min-height: 92rpx; color: var(--primary); }
