.custom-page {
  padding-bottom: calc(188rpx + env(safe-area-inset-bottom));
}

.section-head {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  min-height: 184rpx;
  margin-bottom: 34rpx;
  padding-right: 184rpx;
}

.eyebrow {
  width: fit-content;
  border: 1rpx solid rgba(185, 118, 78, 0.14);
  border-radius: 999rpx;
  background: #fff1dc;
  color: #8b4f3b;
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 18rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
}

.subtitle,
.group-help {
  color: #6f5d51;
  font-size: 24rpx;
  line-height: 1.5;
}

.topping-toy {
  position: absolute;
  top: 8rpx;
  right: 0;
  width: 164rpx;
  height: 164rpx;
  filter: drop-shadow(0 16rpx 18rpx rgba(101, 62, 39, 0.12));
}

.builder-surface {
  display: flex;
  flex-direction: column;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(185, 118, 78, 0.12);
  box-shadow: 0 16rpx 30rpx rgba(101, 62, 39, 0.06);
}

.builder-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.builder-group + .builder-group {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid rgba(185, 118, 78, 0.12);
}

.group-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border: 1rpx solid rgba(185, 118, 78, 0.18);
  border-radius: 999rpx;
  background: #fff0da;
  color: #8b4f3b;
  font-size: 24rpx;
  font-weight: 900;
}

.label {
  color: #3f2c23;
  font-size: 28rpx;
  font-weight: 800;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.option-grid.two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 82rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(185, 118, 78, 0.14);
  border-radius: 999rpx;
  background: #fff3e0;
  color: #4a3324;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  overflow: hidden;
  box-shadow: 0 8rpx 16rpx rgba(101, 62, 39, 0.05);
  transition: transform 180ms ease-out, box-shadow 180ms ease-out;
}

.option::after {
  border: 0;
}

.option:active {
  opacity: 0.96;
  transform: scale(0.97) translateY(2rpx);
}

.option.active {
  border-color: #b9473d;
  background: #b9473d;
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(185, 71, 61, 0.18);
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(185, 118, 78, 0.1);
  background: linear-gradient(180deg, rgba(255, 244, 229, 0), #fff4e5 24%);
}

.submit {
  width: 100%;
  min-height: 96rpx;
  margin: 0;
}
