.section-head,
.option-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.section-head {
  gap: 14rpx;
  margin-bottom: 34rpx;
}

.eyebrow {
  width: fit-content;
  border-radius: 999rpx;
  background: #f6e5ce;
  color: #8b5f3f;
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 18rpx;
}

.option-group {
  padding: 26rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 900;
}

.subtitle,
.label {
  color: #7f7168;
  font-size: 24rpx;
}

.label {
  font-weight: 800;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.option-grid.two {
  grid-template-columns: repeat(2, 1fr);
}

.option {
  min-height: 72rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f6e5ce;
  color: #4a3324;
  font-size: 24rpx;
  font-weight: 700;
}

.option::after {
  border: 0;
}

.option:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.option.active {
  background: #6b3f2a;
  color: #fff8ec;
}

.submit {
  margin-top: 24rpx;
}
