.stats-page { padding-top: 30rpx; }
.stats-heading { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 28rpx; }
.stats-heading .page-title { font-size: 40rpx; }
.stats-subtitle { color: #8a7566; font-size: 24rpx; }
.period-switch { display: flex; padding: 7rpx; margin-bottom: 24rpx; border-radius: 999rpx; background: #f1dfcc; }
.period-option { flex: 1; min-height: 68rpx; padding: 0; margin: 0; border: 0; border-radius: 999rpx; background: transparent; color: #8a7566; font-size: 26rpx; }
.period-option.active { background: #fff9f0; color: #b9473d; font-weight: 800; box-shadow: 0 3rpx 10rpx rgba(95, 61, 49, .08); }
.period-option::after, .chart-column::after, .calendar-link::after { border: 0; }
.summary-card, .chart-card, .calorie-card { padding: 30rpx; }
.period-label, .summary-caption, .calorie-caption { color: #8a7566; font-size: 23rpx; }
.summary-values { display: flex; align-items: end; margin-top: 18rpx; }
.summary-cups { display: flex; align-items: baseline; flex: 1; }
.summary-number { color: #b9473d; font-size: 102rpx; line-height: 1; font-weight: 900; }
.summary-unit { margin-left: 9rpx; color: #8a7566; font-size: 25rpx; }
.summary-days { display: flex; flex: 0 0 36%; flex-direction: column; gap: 10rpx; padding-left: 28rpx; border-left: 1rpx solid #ead9c6; }
.days-number { font-size: 50rpx; font-weight: 800; line-height: 1; }
.stats-content { display: flex; flex-direction: column; gap: 24rpx; margin-top: 24rpx; }
.card-title { display: block; font-size: 28rpx; font-weight: 800; }
.card-description, .calorie-note { display: block; margin-top: 10rpx; color: #8a7566; font-size: 22rpx; line-height: 1.4; }
.chart-columns { display: flex; justify-content: space-around; align-items: end; gap: 2rpx; height: 220rpx; margin-top: 24rpx; border-bottom: 1rpx solid #dbc6b0; }
.chart-column { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: end; min-width: 0; height: 100%; padding: 0; margin: 0; border: 0; background: transparent; }
.chart-track { display: flex; align-items: end; justify-content: center; width: 100%; height: 160rpx; }
.chart-bar { width: 55%; max-width: 45rpx; min-width: 12rpx; border-radius: 10rpx 10rpx 0 0; background: #ead9c6; }
.chart-bar.filled { background: #b9473d; }
.chart-label { overflow: hidden; width: 100%; height: 46rpx; color: #8a7566; font-size: 19rpx; line-height: 46rpx; text-align: center; text-overflow: clip; white-space: nowrap; }
.calorie-value { display: flex; align-items: baseline; margin-top: 12rpx; font-size: 44rpx; font-weight: 800; }
.calorie-unit { margin-left: 10rpx; color: #8a7566; font-size: 23rpx; font-weight: 500; }
.calendar-link { align-self: center; min-height: 64rpx; padding: 0 16rpx; margin: 0; border: 0; background: transparent; color: #a94338; font-size: 24rpx; font-weight: 800; }
.stats-empty { display: flex; flex-direction: column; gap: 18rpx; margin-top: 24rpx; padding: 44rpx 30rpx; text-align: center; }
.empty-title { font-size: 30rpx; font-weight: 800; }
.empty-copy { color: #8a7566; font-size: 24rpx; line-height: 1.5; }
.stats-empty .button-primary { margin-top: 12rpx; }
.stats-error { display: flex; flex-direction: column; gap: 18rpx; padding: 30rpx; }
