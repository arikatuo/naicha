<view class="page stats-page">
  <view wx:if="{{storageError}}" class="surface stats-error">
    <text>记录暂时无法读取</text>
    <button class="button-secondary" bindtap="refresh">重试</button>
  </view>

  <view wx:else class="stats-body">
    <view class="period-controls">
      <view class="period-switch" role="tablist" aria-label="统计时间范围">
        <button wx:for="{{periods}}" wx:key="key" class="period-option {{activePeriod === item.key ? 'active' : ''}}" role="tab" aria-selected="{{activePeriod === item.key}}" data-period="{{item.key}}" bindtap="changePeriod">{{item.label}}</button>
      </view>
      <text class="period-range" aria-live="polite">{{periodLabel}}</text>
    </view>

    <view wx:if="{{hasPeriodRecords}}" class="summary-card surface">
      <view class="summary-values">
        <view class="summary-cups"><text class="summary-number">{{cups}}</text><text class="summary-unit">杯</text></view>
        <view class="summary-days"><text class="summary-caption">有记录的天数</text><view><text class="days-number">{{days}}</text><text class="summary-unit">天</text></view></view>
      </view>
    </view>

    <view wx:if="{{hasPeriodRecords}}" class="stats-content">
      <view class="chart-card surface">
        <text class="card-title">{{chartTitle}}</text>
        <text class="card-description">{{chartDescription}}</text>
        <scroll-view class="chart-scroll" scroll-x="{{activePeriod === 'year'}}">
          <view class="chart-columns {{activePeriod === 'year' ? 'year-chart' : ''}}">
            <button wx:for="{{buckets}}" wx:key="label" class="chart-column" data-index="{{index}}" bindtap="openBucket" disabled="{{!item.count}}" aria-label="{{item.label}}已记录{{item.count}}杯，展开记录日期">
              <view class="chart-track"><text wx:if="{{item.count}}" class="chart-count">{{item.count}}</text><view class="chart-bar {{item.count ? 'filled' : ''}}" style="height: {{item.height}}rpx"></view></view>
              <text class="chart-label">{{item.label}}</text>
            </button>
          </view>
        </scroll-view>
        <view wx:if="{{selectedBucket}}" class="bucket-detail" aria-live="polite">
          <text class="bucket-detail-title">{{selectedBucket.label}} · {{selectedBucket.count}}杯记录</text>
          <view class="bucket-dates">
            <button wx:for="{{selectedBucket.dates}}" wx:key="date" class="bucket-date" data-date="{{item.date}}" bindtap="openRecordDate">{{item.displayDate}} · {{item.count}}杯 ›</button>
          </view>
        </view>
      </view>

      <view class="calorie-card surface">
        <text class="calorie-caption">记录热量合计 · 估算</text>
        <view class="calorie-value"><text>约 {{calories}}</text><text class="calorie-unit">kcal</text></view>
      </view>
      <button class="calendar-link" bindtap="goToCalendar">查看日历里的具体记录 ›</button>
    </view>

    <view wx:if="{{!hasPeriodRecords}}" class="stats-empty" aria-live="polite">
      <view class="empty-content">
        <view class="empty-emblem" aria-hidden="true">
          <image src="/assets/tabs/stats-active.png" mode="aspectFit"></image>
        </view>
        <text class="empty-title">{{activePeriodLabel}}还没有记录</text>
        <button class="button-primary" bindtap="startRecord">记录一杯</button>
      </view>
    </view>
  </view>
</view>
