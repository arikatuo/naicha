.diary-page {
  padding-top: 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.diary-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.diary-subtitle {
  flex: 1;
  color: #8a7566;
  font-size: 25rpx;
  line-height: 1.45;
}

.stats-entry { flex: 0 0 auto; min-height: 64rpx; padding: 0 18rpx; margin: 0; border: 1rpx solid rgba(185, 71, 61, .18); border-radius: 999rpx; background: #fff9f0; color: #a94338; font-size: 24rpx; font-weight: 800; line-height: 64rpx; }
.stats-entry::after { border: 0; }

.diary-content { display: flex; flex-direction: column; gap: 24rpx; }
.history-content { display: flex; flex-direction: column; gap: 24rpx; }

.calendar-card {
  padding: 22rpx 14rpx 26rpx;
  border: 0;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(95, 61, 49, 0.05);
}

.month-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.month-center { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 3rpx; }
.month-title { font-size: 34rpx; font-weight: 900; color: #2d1f18; }

.month-arrow {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  min-height: 64rpx;
  padding: 0 0 6rpx;
  margin: 0;
  border: 0;
  background: transparent;
  color: #5f3d31;
  font-size: 50rpx;
  line-height: 1;
}
.month-arrow::after, .day-button::after, .record-actions button::after { border: 0; }

.weekdays, .days-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.weekdays text {
  color: #8a7566;
  font-size: 21rpx;
  line-height: 1.4;
  text-align: center;
  padding-bottom: 10rpx;
}

.day-cell {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 75rpx;
}

.day-button {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 66rpx;
  height: 66rpx;
  min-height: 66rpx;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: #2d1f18;
  font-size: 26rpx;
  line-height: 1;
}

.day-button.selected {
  background: #b9473d;
  color: #fff;
  font-weight: 800;
}

.record-dot {
  position: absolute;
  bottom: 3rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #b9473d;
}
.selected .record-dot { background: #fff; }

.empty-card, .day-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 34rpx 30rpx;
  border: 0;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(95, 61, 49, 0.05);
}

.empty-cup { width: 116rpx; height: 116rpx; margin-bottom: 2rpx; }
.empty-title { color: #2d1f18; font-size: 34rpx; font-weight: 900; line-height: 1.25; }
.empty-copy { color: #8a7566; font-size: 24rpx; line-height: 1.45; text-align: center; margin: 12rpx 0 22rpx; }
.example-record { width: 100%; box-sizing: border-box; padding: 18rpx 22rpx; margin-bottom: 22rpx; border-radius: 20rpx; background: #fff0dc; }
.example-kicker, .example-hint { display: block; color: #8a7566; font-size: 21rpx; line-height: 1.4; }
.example-row { display: flex; justify-content: space-between; gap: 16rpx; margin: 9rpx 0; color: #2d1f18; font-size: 26rpx; font-weight: 800; }
.example-hint { font-size: 22rpx; }
.record-button { width: 100%; min-height: 86rpx; font-size: 29rpx; }

.save-confirmation { display: flex; flex-direction: column; gap: 7rpx; padding: 22rpx 28rpx; border-color: rgba(185, 71, 61, 0.28); background: #fff0dc; }
.save-confirmation-title { color: #8b3d32; font-size: 27rpx; font-weight: 900; }
.save-confirmation-detail { color: #5f3d31; font-size: 23rpx; line-height: 1.4; }
.history-summary { display: flex; align-items: center; gap: 24rpx; padding: 22rpx 28rpx; }
.history-stat { display: flex; flex: 0 0 185rpx; flex-direction: column; gap: 5rpx; }
.history-stat-value { color: #b9473d; font-size: 48rpx; font-weight: 900; line-height: 1; }
.history-stat-label, .latest-kicker { color: #8a7566; font-size: 21rpx; }
.latest-drink { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; padding-left: 24rpx; border-left: 1rpx solid #ead9c6; }
.latest-name { overflow: hidden; color: #2d1f18; font-size: 25rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.latest-repeat { align-self: flex-start; min-height: 40rpx; padding: 0; margin: 0; border: 0; background: transparent; color: #a94338; font-size: 23rpx; font-weight: 800; line-height: 40rpx; }
.latest-repeat::after { border: 0; }

.day-panel { align-items: stretch; gap: 22rpx; }
.day-panel-head { display: flex; justify-content: space-between; align-items: baseline; }
.day-panel-title { font-size: 32rpx; font-weight: 900; }
.day-panel-count, .day-empty { color: #8a7566; font-size: 24rpx; }
.record-list { display: flex; flex-direction: column; gap: 16rpx; }
.record-card { padding: 18rpx; border-radius: 22rpx; background: #fff4e5; }
.record-copy { display: flex; flex-direction: column; gap: 5rpx; }
.record-name { font-size: 27rpx; font-weight: 800; line-height: 1.35; }
.record-calories { font-size: 23rpx; color: #8a7566; }
.record-actions { display: flex; align-items: center; gap: 24rpx; margin-top: 14rpx; color: #8b4f3b; font-size: 23rpx; }
.record-actions button { min-height: 48rpx; padding: 0; margin: 0; border: 0; background: transparent; color: #8b4f3b; font-size: 23rpx; line-height: 48rpx; }
.record-actions picker { line-height: 48rpx; }
.day-empty { line-height: 1.5; }
.diary-error { display: flex; flex-direction: column; gap: 16rpx; padding: 30rpx; }

@media (min-height: 760px) {
  .day-cell { min-height: 92rpx; }
  .empty-card { min-height: 510rpx; justify-content: center; }
  .empty-cup { width: 148rpx; height: 148rpx; }
}
