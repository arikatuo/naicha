.home-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  overflow: visible;
}

.toy-orbit {
  position: relative;
  min-height: 260rpx;
  margin-top: 0;
}

.toy-orbit::before,
.toy-orbit::after {
  content: "";
  position: absolute;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #bde8d1, #f6c2b2);
  box-shadow:
    0 22rpx 44rpx rgba(126, 78, 49, 0.16),
    inset 8rpx 10rpx 18rpx rgba(255, 255, 255, 0.42),
    inset -8rpx -10rpx 20rpx rgba(125, 78, 49, 0.14);
}

.toy-orbit::before {
  width: 150rpx;
  height: 150rpx;
  left: 8rpx;
  top: 28rpx;
}

.toy-orbit::after {
  width: 94rpx;
  height: 94rpx;
  right: 24rpx;
  top: 26rpx;
  background: linear-gradient(145deg, #fde69b, #ef9f9a);
}

.hero-cup {
  position: absolute;
  left: 148rpx;
  top: -8rpx;
  width: 330rpx;
  height: 330rpx;
  filter: drop-shadow(0 26rpx 24rpx rgba(101, 62, 39, 0.18));
}

.hero-pearls {
  position: absolute;
  right: 28rpx;
  bottom: 6rpx;
  width: 138rpx;
  height: 138rpx;
  filter: drop-shadow(0 16rpx 18rpx rgba(101, 62, 39, 0.15));
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 0;
}

.title {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.12;
  text-shadow: 0 6rpx 0 rgba(255, 255, 255, 0.52);
}

.title-line {
  display: block;
}

.title-accent {
  color: #8b4f3b;
}

.subtitle {
  color: #6f6258;
  font-size: 32rpx;
  line-height: 1.5;
}

.preview-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 30rpx;
  border-color: rgba(95, 61, 49, 0.06);
  box-shadow: 0 10rpx 22rpx rgba(95, 61, 49, 0.07);
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.preview-kicker {
  color: #8b5f3f;
  font-size: 24rpx;
  font-weight: 800;
}

.preview-calorie {
  color: #2d211b;
  font-size: 38rpx;
  font-weight: 900;
}

.preview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.preview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-height: 150rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #fff8ed, #f7dcc0);
  box-shadow: 0 8rpx 16rpx rgba(139, 95, 63, 0.08);
  padding: 16rpx 8rpx;
}

.preview-item image {
  width: 70rpx;
  height: 70rpx;
}

.preview-item text {
  color: #513929;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  width: 100%;
}

.actions button {
  width: 100%;
}

.disclaimer {
  color: #6f5d51;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
  margin-top: 4rpx;
}