.home-page {
  display: flex;
  flex-direction: column;
  gap: 34rpx;
  overflow: hidden;
}

.toy-orbit {
  position: relative;
  min-height: 300rpx;
  margin-top: 6rpx;
}

.toy-orbit::before,
.toy-orbit::after {
  content: "";
  position: absolute;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #bde8d1, #f6c2b2);
  box-shadow:
    0 22rpx 44rpx rgba(126, 78, 49, 0.16),
    inset 8rpx 10rpx 18rpx rgba(255, 255, 255, 0.42),
    inset -8rpx -10rpx 20rpx rgba(125, 78, 49, 0.14);
}

.toy-orbit::before {
  width: 150rpx;
  height: 150rpx;
  left: 8rpx;
  top: 28rpx;
}

.toy-orbit::after {
  width: 94rpx;
  height: 94rpx;
  right: 24rpx;
  top: 26rpx;
  background: linear-gradient(145deg, #fde69b, #ef9f9a);
}

.hero-cup {
  position: absolute;
  left: 148rpx;
  top: -18rpx;
  width: 360rpx;
  height: 360rpx;
  filter: drop-shadow(0 26rpx 24rpx rgba(101, 62, 39, 0.18));
}

.hero-pearls {
  position: absolute;
  right: 28rpx;
  bottom: 0;
  width: 148rpx;
  height: 148rpx;
  filter: drop-shadow(0 16rpx 18rpx rgba(101, 62, 39, 0.15));
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 0;
}

.eyebrow {
  width: fit-content;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff6df, #efbf98);
  color: #8b4f3b;
  font-size: 26rpx;
  font-weight: 900;
  padding: 12rpx 22rpx;
  box-shadow:
    0 10rpx 20rpx rgba(139, 95, 63, 0.13),
    inset 5rpx 6rpx 12rpx rgba(255, 255, 255, 0.56),
    inset -5rpx -7rpx 12rpx rgba(174, 101, 73, 0.16);
}

.title {
  max-width: 620rpx;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1.15;
  text-shadow: 0 6rpx 0 rgba(255, 255, 255, 0.52);
}

.subtitle {
  color: #6f6258;
  font-size: 32rpx;
  line-height: 1.5;
}

.preview-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 34rpx;
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.preview-kicker {
  color: #8b5f3f;
  font-size: 24rpx;
  font-weight: 800;
}

.preview-calorie {
  color: #2d211b;
  font-size: 40rpx;
  font-weight: 900;
}

.preview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.preview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-height: 166rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #fff8e9, #f4caa1);
  box-shadow:
    0 14rpx 24rpx rgba(139, 95, 63, 0.14),
    inset 7rpx 9rpx 14rpx rgba(255, 255, 255, 0.58),
    inset -7rpx -9rpx 16rpx rgba(172, 102, 68, 0.16);
  padding: 18rpx 10rpx;
}

.preview-item image {
  width: 76rpx;
  height: 76rpx;
}

.preview-item text {
  color: #513929;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.disclaimer {
  color: #8a7b70;
  font-size: 24rpx;
  text-align: center;
  margin-top: auto;
}
