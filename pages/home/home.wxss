.diary-page {
  display: flex;
  flex-direction: column;
  padding-top: 24rpx;
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

.diary-content { display: flex; flex-direction: column; gap: 24rpx; }

/* ---------- 日历 ---------- */
.calendar-card { padding: 20rpx 16rpx 24rpx; }

.month-header { display: flex; align-items: center; margin-bottom: 8rpx; }
.month-center { display: flex; flex: 1; align-items: center; justify-content: center; min-width: 0; }
.month-title { font-size: 34rpx; font-weight: var(--fw-strong); color: var(--text); }

.month-arrow {
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-height: 88rpx;
  padding: 0 0 6rpx;
  margin: 0;
  border: 0;
  background: transparent;
  color: var(--text-2);
  font-size: 48rpx;
  line-height: 1;
}
.month-arrow::after, .day-button::after, .record-repeat::after, .record-more::after,
.more-action::after, .latest-repeat::after { border: 0; }

.weekdays, .days-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.weekdays text {
  padding-bottom: 8rpx;
  color: var(--text-3);
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}
.weekdays .weekend { color: #b0665f; }

.day-cell {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  min-height: 84rpx;
  padding-top: 4rpx;
  box-sizing: border-box;
}

.day-button {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 64rpx;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: var(--r-pill);
  background: transparent;
  color: var(--text);
  font-size: 27rpx;
  line-height: 1;
}
.day-button.today { box-shadow: inset 0 0 0 2rpx var(--primary); color: var(--primary); font-weight: var(--fw-strong); }
.day-button.selected { background: var(--primary); color: #fff; font-weight: var(--fw-strong); box-shadow: none; }

/* 热量点：颜色代表当天总热量，位置固定在日期下方 */
.heat-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }
.day-cell .heat-dot { position: absolute; bottom: 4rpx; left: 50%; margin-left: -5rpx; }
.tier-1 { background: var(--heat-1); }
.tier-2 { background: var(--heat-2); }
.tier-3 { background: var(--heat-3); }
.heat-dot.on-selected { box-shadow: 0 0 0 4rpx var(--surface); }

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 8rpx;
  color: var(--text-3);
  font-size: 22rpx;
}
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-title { margin-right: 4rpx; }

/* ---------- 保存成功提示 ---------- */
.save-confirmation {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--r-md);
  background: var(--primary-soft);
}
.save-confirmation-title { color: var(--primary); font-size: 27rpx; font-weight: var(--fw-strong); }
.save-confirmation-detail { color: var(--text-2); font-size: 24rpx; line-height: 1.4; }

/* ---------- 当天面板 ---------- */
.day-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: var(--r-lg);
  background: var(--surface-soft);
}
.day-panel-head { display: flex; justify-content: space-between; align-items: baseline; }
.day-panel-title { color: var(--primary); font-size: 40rpx; font-weight: var(--fw-strong); line-height: 1.1; }
.day-panel-count { color: var(--text-2); font-size: var(--fs-cap); }

.record-list { display: flex; flex-direction: column; gap: 16rpx; }
.record-card { padding: 8rpx 8rpx 8rpx 24rpx; border-radius: var(--r-md); background: var(--surface); }
.record-main { display: flex; align-items: center; gap: 8rpx; min-height: 112rpx; }
.record-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; }
.record-name { overflow: hidden; font-size: 28rpx; font-weight: var(--fw-strong); line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.record-calories { color: var(--text-2); font-size: 23rpx; }

.record-repeat {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 24rpx;
  margin: 0;
  border: 0;
  border-radius: var(--r-pill);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: var(--fw-strong);
  line-height: 1;
}

.record-more {
  flex: 0 0 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-height: 88rpx;
  padding: 0 0 8rpx;
  margin: 0;
  border: 0;
  background: transparent;
  color: var(--text-3);
  font-size: 40rpx;
  line-height: 1;
}

.record-more-row { display: flex; border-top: 1rpx solid var(--line); margin: 0 16rpx 0 0; }
.more-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  color: var(--text-2);
  font-size: 26rpx;
  font-weight: var(--fw-strong);
  line-height: 1;
}
.more-action.danger { color: var(--primary); }

.day-empty { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 8rpx 0 4rpx; }
.day-empty-cup { width: 150rpx; height: 150rpx; margin-bottom: 4rpx; }
.day-empty-title { font-size: 30rpx; font-weight: var(--fw-strong); }
.day-empty-copy { color: var(--text-2); font-size: 25rpx; }

.record-button { min-height: 92rpx; font-size: 29rpx; }

/* ---------- 月度小结 ---------- */
.history-summary { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 28rpx; }
.history-stat { display: flex; flex: 0 0 200rpx; flex-direction: column; gap: 6rpx; }
.history-stat-value { color: var(--primary); font-size: 48rpx; font-weight: var(--fw-strong); line-height: 1; }
.history-stat-label, .latest-kicker { color: var(--text-3); font-size: 22rpx; }
.latest-drink { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; padding-left: 24rpx; border-left: 1rpx solid var(--line); }
.latest-name { overflow: hidden; font-size: 26rpx; font-weight: var(--fw-strong); text-overflow: ellipsis; white-space: nowrap; }
.latest-repeat { align-self: flex-start; min-height: 64rpx; padding: 0; margin: 0; border: 0; background: transparent; color: var(--primary); font-size: 24rpx; font-weight: var(--fw-strong); line-height: 64rpx; }

.diary-error { display: flex; flex-direction: column; gap: 16rpx; padding: 30rpx; }
