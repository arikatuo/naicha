<view class="page diary-page">
  <view wx:if="{{storageError}}" class="surface diary-error">
    <text>记录暂时无法读取</text>
    <button class="button-secondary" bindtap="refresh">重试</button>
  </view>

  <view wx:else class="diary-content">
    <view class="calendar-card surface">
      <view class="month-header">
        <button class="month-arrow" bindtap="previousMonth" aria-label="上个月">‹</button>
        <view class="month-center">
          <text class="month-title">{{monthLabel}}</text>
        </view>
        <button class="month-arrow" bindtap="nextMonth" aria-label="下个月">›</button>
      </view>
      <view class="weekdays">
        <text>周一</text><text>周二</text><text>周三</text><text>周四</text><text>周五</text><text>周六</text><text>周日</text>
      </view>
      <view class="days-grid">
        <view wx:for="{{cells}}" wx:key="key" class="day-cell">
          <button wx:if="{{item.date}}" class="day-button {{item.selected ? 'selected' : ''}}" data-date="{{item.date}}" bindtap="selectDay" aria-label="{{item.date}}{{item.count ? '，有记录' : ''}}">
            <text>{{item.day}}</text>
            <view wx:if="{{item.count}}" class="record-dot"></view>
          </button>
        </view>
      </view>
    </view>

    <view wx:if="{{justSavedRecord}}" class="save-confirmation surface" aria-live="polite">
      <text class="save-confirmation-title">已记到{{selectedDateLabel}}的日历</text>
      <text class="save-confirmation-detail">{{justSavedRecord.brandName ? justSavedRecord.brandName + ' · ' : ''}}{{justSavedRecord.drinkName}} · 约 {{justSavedRecord.calories}} kcal</text>
    </view>

    <view wx:if="{{!hasRecords}}" class="empty-card surface">
      <image class="empty-cup" src="/assets/icons/milk-tea-cup.png" mode="aspectFit" aria-hidden="true"></image>
      <view class="empty-action">
        <text class="empty-title">{{emptyTitle}}</text>
        <button class="button-primary record-button" disabled="{{selectedInFuture}}" bindtap="startRecord">{{recordButtonLabel}}</button>
      </view>
    </view>

    <view wx:else class="history-content">
      <view class="history-summary surface">
        <view class="history-stat"><text class="history-stat-value">{{monthCount}}</text><text class="history-stat-label">这个月已记的杯数</text></view>
        <view wx:if="{{latestRecord}}" class="latest-drink">
          <text class="latest-kicker">最近一杯</text>
          <text class="latest-name">{{latestRecord.brandName ? latestRecord.brandName + ' · ' : ''}}{{latestRecord.drinkName}}</text>
          <button class="latest-repeat" data-id="{{latestRecord.id}}" bindtap="repeatRecord">再记这杯 ›</button>
        </view>
      </view>
      <view class="day-panel surface">
      <view class="day-panel-head">
        <text class="day-panel-title">{{selectedDateLabel}}</text>
        <text class="day-panel-count">{{hasSelectedRecords ? selectedRecords.length + ' 杯记录' : '还没有记录'}}</text>
      </view>
      <view wx:if="{{hasSelectedRecords}}" class="record-list">
        <view wx:for="{{selectedRecords}}" wx:key="id" class="record-card">
          <view class="record-copy">
            <text class="record-name">{{item.brandName ? item.brandName + ' · ' : ''}}{{item.drinkName}}</text>
            <text class="record-calories">约 {{item.calories}} kcal · 估算</text>
          </view>
          <view class="record-actions">
            <button data-id="{{item.id}}" bindtap="repeatRecord">再记这杯</button>
            <picker mode="date" value="{{item.date}}" end="{{todayDate}}" data-id="{{item.id}}" bindchange="changeRecordDate"><text>改日期</text></picker>
            <button data-id="{{item.id}}" bindtap="removeRecord">删除</button>
          </view>
        </view>
      </view>
      <text wx:else class="day-empty">这天还没有记录，想补记哪一杯？</text>
      <button class="button-primary record-button" disabled="{{selectedInFuture}}" bindtap="startRecord">{{recordButtonLabel}}</button>
      </view>
    </view>
  </view>
</view>
