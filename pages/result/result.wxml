<view class="page result-page {{resultCopy.theme}}">
  <view class="summary surface">
    <text class="eyebrow">揭晓结果</text>
    <text class="result-title">{{resultCopy.title}}</text>
    <view class="calorie-row">
      <text class="calories">约 {{payload.calories}} kcal</text>
      <text class="badge">估算</text>
    </view>
    <text class="drink-name">{{payload.brandName ? payload.brandName + ' · ' : ''}}{{payload.drinkName}}</text>
    <text class="disclaimer">{{disclaimer}}</text>
  </view>

  <view class="cards">
    <view wx:for="{{cards}}" wx:key="id" class="equivalent-card">
      <image class="icon" src="{{item.icon}}" mode="aspectFit"></image>
      <text class="card-text">{{item.text}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="button-primary" bindtap="generatePoster">生成分享图</button>
    <button class="button-secondary" bindtap="recalculate">再算一杯</button>
  </view>

  <canvas canvas-id="posterCanvas" class="poster-canvas"></canvas>
</view>
