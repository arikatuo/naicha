<view class="page result-page {{resultCopy.theme}}">
  <view wx:if="{{hasResult}}" class="result-shell">
    <view class="summary result-surface" aria-live="polite">
      <text class="summary-kicker">揭晓结果</text>
      <view class="calorie-row">
        <text class="calorie-prefix">约</text>
        <text class="calorie-number">{{payload.calories}}</text>
        <text class="calorie-unit">kcal</text>
      </view>
      <view class="badge-row">
        <text class="result-badge">{{resultCopy.badge}}</text>
        <text class="estimate-badge">估算</text>
      </view>
      <text class="result-title">{{resultCopy.title}}</text>
      <view class="summary-footer">
        <text class="drink-name">{{payload.brandName ? payload.brandName + ' · ' : ''}}{{payload.drinkName}}</text>
        <text class="disclaimer">{{disclaimer}}</text>
      </view>
    </view>

    <view class="equivalent-stage">
      <text class="stage-label">等于什么</text>
      <view class="equivalent-grid">
        <view wx:for="{{primaryCards}}" wx:key="id" class="equivalent-card equivalent-card-large">
          <view class="icon-well">
            <image class="icon" src="{{item.icon}}" mode="aspectFit"></image>
          </view>
          <view class="card-body">
            <view class="metric-row">
              <text class="card-number">{{item.numberMain}}</text>
              <text class="card-unit">{{item.numberUnit}}</text>
            </view>
            <text class="card-label">{{item.label}}</text>
            <text class="card-sub">{{item.hint}}</text>
          </view>
        </view>

        <view wx:for="{{secondaryCards}}" wx:key="id" class="equivalent-card equivalent-card-small">
          <view class="icon-well small-icon-well">
            <image class="icon small-icon" src="{{item.icon}}" mode="aspectFit"></image>
          </view>
          <view class="card-body">
            <view class="metric-row small-metric-row">
              <text class="card-number small-card-number">{{item.numberMain}}</text>
              <text class="card-unit small-card-unit">{{item.numberUnit}}</text>
            </view>
            <text class="card-label small-card-label">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="actions">
      <button class="button-primary share-button" open-type="share">分享给朋友</button>
      <view class="secondary-actions">
        <button class="button-secondary poster-button" loading="{{posterGenerating}}" disabled="{{posterGenerating}}" bindtap="generatePoster">生成分享图</button>
        <button class="button-secondary recalculate-button" bindtap="recalculate">再算一杯</button>
      </view>
    </view>
  </view>

  <view wx:else class="error-state surface">
    <text class="state-title">结果走丢了</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="button-primary" bindtap="recalculate">重新计算</button>
  </view>

  <view wx:if="{{posterPreviewOpen}}" class="poster-preview-mask" bindtap="closePosterPreview">
    <view class="poster-preview-sheet" catchtap="noop">
      <text class="preview-title">结果图预览</text>
      <image class="poster-preview-image" src="{{previewPosterPath}}" mode="aspectFit"></image>
      <view class="preview-actions">
        <button class="button-primary preview-save" bindtap="savePoster">保存到相册</button>
        <button class="button-text preview-close" bindtap="closePosterPreview">关闭</button>
      </view>
    </view>
  </view>

  <canvas canvas-id="posterCanvas" class="poster-canvas"></canvas>
</view>