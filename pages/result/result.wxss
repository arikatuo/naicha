.result-page {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  height: 100vh;
  min-height: 0;
  justify-content: space-between;
  overflow: hidden;
}

.summary {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  gap: 8rpx;
  border-radius: 38rpx;
  padding: 22rpx 30rpx 24rpx;
}

.eyebrow {
  width: fit-content;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff6df, #efbf98);
  color: #8b4f3b;
  font-size: 22rpx;
  font-weight: 800;
  padding: 7rpx 16rpx;
  box-shadow:
    0 10rpx 20rpx rgba(139, 95, 63, 0.13),
    inset 5rpx 6rpx 12rpx rgba(255, 255, 255, 0.56),
    inset -5rpx -7rpx 12rpx rgba(174, 101, 73, 0.16);
}

.result-title {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.16;
}

.calorie-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  min-width: 0;
}

.calorie-prefix {
  color: #2d1f18;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1;
}

.calorie-number {
  color: #2d1f18;
  font-size: 92rpx;
  font-weight: 900;
  line-height: 0.98;
}

.calorie-unit {
  color: #2d1f18;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.result-badge,
.estimate-badge {
  width: fit-content;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff5df, #edc295);
  color: #6b3f2a;
  box-shadow: inset 4rpx 5rpx 10rpx rgba(255, 255, 255, 0.5);
}

.result-badge {
  font-size: 21rpx;
  font-weight: 900;
  padding: 6rpx 15rpx;
}

.estimate-badge {
  font-size: 20rpx;
  font-weight: 800;
  padding: 6rpx 13rpx;
}

.drink-name {
  color: #77675b;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.disclaimer {
  color: #77675b;
  font-size: 20rpx;
  line-height: 1.35;
}

.equivalent-stage {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  gap: 10rpx;
  min-height: 0;
}

.stage-label {
  color: #8b5f3f;
  font-size: 24rpx;
  font-weight: 900;
  padding-left: 8rpx;
}

.equivalent-swiper {
  width: 100%;
  height: 360rpx;
  flex: 0 0 auto;
}

.equivalent-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  height: 342rpx;
  box-sizing: border-box;
  margin: 8rpx 10rpx 10rpx;
  padding: 24rpx 28rpx;
  border-radius: 38rpx;
  background: linear-gradient(145deg, #fffbf4, #f5cea2);
  box-shadow:
    0 18rpx 30rpx rgba(124, 78, 49, 0.14),
    inset 10rpx 12rpx 20rpx rgba(255, 255, 255, 0.55),
    inset -10rpx -14rpx 22rpx rgba(173, 101, 72, 0.16);
}

.icon {
  width: 116rpx;
  height: 116rpx;
}

.card-text {
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
  line-height: 1.25;
}

.card-sub {
  color: #8a6b58;
  font-size: 21rpx;
  font-weight: 800;
}

.dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(139, 95, 63, 0.24);
  transition: width 180ms ease-out, background 180ms ease-out;
}

.dot.active {
  width: 38rpx;
  background: #ef8178;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 0 0 auto;
  align-self: stretch;
}

.actions button {
  min-height: 78rpx;
  padding: 0 16rpx;
  font-size: 25rpx;
  line-height: 1.15;
  white-space: nowrap;
}

.share-button {
  width: 100%;
  min-height: 86rpx;
  font-size: 28rpx;
}

.secondary-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.fresh .equivalent-card {
  background: linear-gradient(145deg, #f5ffe7, #bde8d1);
}

.warm .equivalent-card {
  background: linear-gradient(145deg, #fff2db, #f6b774);
}

.cocoa .equivalent-card {
  background: linear-gradient(145deg, #f6e3d1, #c99978);
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 360px;
  height: 640px;
}

.poster-preview-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 36rpx;
  background: rgba(47, 36, 29, 0.52);
}

.poster-preview-sheet {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-height: 92vh;
  box-sizing: border-box;
  border-radius: 48rpx;
  background: linear-gradient(145deg, #fff8e8, #f0cda8);
  padding: 28rpx;
  box-shadow:
    0 30rpx 70rpx rgba(47, 36, 29, 0.28),
    inset 10rpx 12rpx 22rpx rgba(255, 255, 255, 0.52),
    inset -10rpx -14rpx 24rpx rgba(168, 99, 68, 0.18);
}

.preview-title {
  color: #3b281d;
  font-size: 30rpx;
  font-weight: 900;
}

.poster-preview-image {
  width: 100%;
  height: 820rpx;
  border-radius: 34rpx;
  background: #fff1dc;
}

.preview-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-save,
.preview-close {
  min-height: 88rpx;
}
