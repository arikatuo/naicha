.result-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: 0;
}

.result-shell {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  width: 100%;
  box-sizing: border-box;
}

.result-surface {
  order: 2;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx 28rpx 22rpx;
  border: 2rpx solid rgba(95, 61, 49, 0.08);
  border-radius: 28rpx;
  background: linear-gradient(145deg, #fff9f0, #f7dfc7);
  box-shadow: 0 14rpx 30rpx rgba(95, 61, 49, 0.10);
}

.calorie-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.calorie-prefix {
  color: #4f342a;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.calorie-number {
  color: #2d1f18;
  font-size: 104rpx;
  font-weight: 900;
  line-height: 0.96;
  letter-spacing: -2rpx;
}

.calorie-unit {
  color: #2d1f18;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.badge-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.result-badge {
  width: fit-content;
  border-radius: 24rpx;
  background: #f4d4b5;
  color: #6a3c2c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
  padding: 8rpx 16rpx;
}

.estimate-badge {
  display: none;
  background: #f2efeb;
}

.result-title {
  color: #2d1f18;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.summary-footer {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(95, 61, 49, 0.08);
}

.drink-name {
  color: #4f342a;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.disclaimer {
  color: #6f5d51;
  font-size: 24rpx;
  line-height: 1.45;
}

.equivalent-stage {
  order: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 0;
  padding-top: 0;
}

.stage-divider {
  display: none;
}

.stage-label {
  color: #4f342a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
  padding-left: 4rpx;
}

.equivalent-frame {
  overflow: hidden;
  border: 2rpx solid rgba(95, 61, 49, 0.08);
  border-radius: 32rpx;
  background: #fff9f0;
  box-shadow: 0 16rpx 34rpx rgba(95, 61, 49, 0.10);
}

.equivalent-swiper,
.equivalent-card {
  height: 260rpx;
}

.swiper-item-inner {
  display: flex;
  width: 100%;
  height: 100%;
}

.equivalent-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 32rpx;
}

.icon-well {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 138rpx;
  height: 138rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #fff0d2, #f2d1a8);
}

.icon {
  width: 112rpx;
  height: 112rpx;
}

.card-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.metric-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.card-number {
  flex: 0 0 auto;
  color: #2d1f18;
  font-size: 78rpx;
  font-weight: 900;
  line-height: 1;
}

.metric-copy {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0 4rpx;
  min-width: 0;
}

.card-unit,
.card-label {
  color: #2d1f18;
  font-size: 30rpx;
  line-height: 1.2;
}

.card-unit {
  font-weight: 800;
}

.card-label {
  font-weight: 700;
}

.card-sub {
  color: #6f5d51;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-top: 10rpx;
}

.carousel-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0 0;
}

.carousel-arrow {
  width: 84rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid rgba(185, 71, 61, 0.16);
  border-radius: 999rpx;
  background: #fff9f0;
  color: #6a3c2c;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.carousel-arrow::after {
  border: 0;
}

.carousel-count {
  color: #6f5d51;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.actions {
  order: 3;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
  width: 100%;
  margin-top: 0;
  padding-bottom: 28rpx;
}

.secondary-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
}

.share-button {
  width: 90%;
  justify-self: center;
  min-height: 88rpx;
  margin: 0;
}

.poster-button,
.recalculate-button {
  width: auto;
  min-width: 0;
  min-height: 80rpx;
  padding: 0 18rpx;
  font-size: 27rpx;
  margin: 0;
}

.secondary-actions .button-secondary {
  border: 2rpx solid #d5cfc8;
  background: transparent;
  color: #8a8078;
  font-weight: 500;
  box-shadow: none;
}

.error-state {
  margin-top: 20rpx;
}

.poster-canvas {
  width: 360px;
  height: 640px;
}

.poster-preview-image {
  width: 100%;
  height: 760rpx;
}

.preview-save {
  min-height: 88rpx;
}

.preview-close {
  min-height: 72rpx;
}