/* ═══════════════════════════════════════════════════
   result.wxss
   布局重构：数字前置 · 横向等价卡片 · 分组间距
   视觉风格（颜色/阴影/圆角）保持原版不变
═══════════════════════════════════════════════════ */

/* ── 页面容器 ───────────────────────────────────── */
.result-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-top: 0;
  min-height: 0;
  align-items: stretch;
  justify-content: flex-start;
  overflow: hidden;
}

.result-shell {
  display: grid;
  grid-template-rows: auto auto auto;
  width: 100%;
  height: 100%;
  min-height: 0;
  align-content: space-between;
  padding-top: 0;
  box-sizing: border-box;
}

/* ── 摘要卡片 ───────────────────────────────────── */
.summary {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  gap: 0;
  border-radius: 38rpx;
  padding: 34rpx 36rpx 28rpx;
}

/* eyebrow 胶囊 */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  width: fit-content;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff6df, #efbf98);
  color: #8b4f3b;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
  padding: 8rpx 16rpx;
  margin-bottom: 14rpx;
  box-shadow:
    0 10rpx 20rpx rgba(139, 95, 63, 0.13),
    inset 5rpx 6rpx 12rpx rgba(255, 255, 255, 0.56),
    inset -5rpx -7rpx 12rpx rgba(174, 101, 73, 0.16);
}

.eyebrow-dot {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #ef8178;
}

/* 热量数字 — 绝对视觉主角 */
.calorie-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.calorie-prefix {
  color: #2d1f18;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.calorie-number {
  color: #2d1f18;
  font-size: 116rpx;
  font-weight: 900;
  line-height: 0.95;
  letter-spacing: 0;
}

.calorie-unit {
  color: #2d1f18;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

/* badge + 估算 同行横排 */
.badge-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.result-badge,
.estimate-badge {
  width: fit-content;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff5df, #edc295);
  color: #6b3f2a;
  box-shadow: inset 4rpx 5rpx 10rpx rgba(255, 255, 255, 0.5);
}

.result-badge {
  font-size: 21rpx;
  font-weight: 900;
  padding: 6rpx 15rpx;
}

.estimate-badge {
  font-size: 20rpx;
  font-weight: 800;
  padding: 6rpx 13rpx;
}

/* 结果文案 */
.result-title {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
  color: #2d1f18;
  margin-bottom: 16rpx;
}

/* 饮品名 + disclaimer 分组，加分隔线 */
.summary-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(188, 126, 82, 0.18);
}

.drink-name {
  flex: 1 1 auto;
  min-width: 0;
  color: #4a3328;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.disclaimer {
  flex: 0 0 auto;
  color: #a08878;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.35;
}

/* ── 等价换算区 ─────────────────────────────────── */
.equivalent-stage {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  justify-content: flex-start;
  min-height: 0;
  overflow: hidden;
}

.equivalent-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  flex: 0 0 auto;
}

/* 区域标题 — 轻量引导文字 */
.stage-label {
  color: #8b5f3f;
  font-size: 22rpx;
  font-weight: 500;
  padding-left: 8rpx;
}

/* 卡片外壳 */
.equivalent-frame {
  overflow: hidden;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #fffaf1, #f9d9b4);
  box-shadow:
    0 20rpx 36rpx rgba(124, 78, 49, 0.14),
    inset 10rpx 12rpx 20rpx rgba(255, 255, 255, 0.55),
    inset -10rpx -14rpx 22rpx rgba(173, 101, 72, 0.16);
}

.equivalent-swiper {
  width: 100%;
  height: 300rpx;
  flex: 0 0 auto;
}

/* 微信 swiper-item 是原生组件，display:flex 直接加在它身上不生效。
   用内层 view.swiper-item-inner 作为真正的 flex 容器。 */
.swiper-item-inner {
  width: 100%;
  height: 100%;
  display: flex;
}

/* 单张卡片 — 横向布局：图标左 / 数字右 */
.equivalent-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 30rpx;
  width: 100%;
  height: 300rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  padding: 30rpx 34rpx;
}

.equivalent-top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: #ef8178;
  border-radius: 34rpx 34rpx 0 0;
}

/* 图标容器 */
.icon-well {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #fff8e8, #f0c999);
  box-shadow:
    0 10rpx 20rpx rgba(124, 78, 49, 0.12),
    inset 6rpx 7rpx 14rpx rgba(255, 255, 255, 0.58),
    inset -6rpx -8rpx 14rpx rgba(168, 99, 68, 0.14);
}

.icon {
  width: 136rpx;
  height: 136rpx;
}

/* 右侧文字区 */
.card-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

.metric-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  width: 100%;
  min-width: 0;
  line-height: 1;
}

.card-number {
  flex: 0 0 auto;
  color: #2d1f18;
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0;
}

.metric-copy {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0 6rpx;
  min-width: 0;
  padding-bottom: 6rpx;
}

.card-unit,
.card-label {
  font-size: 34rpx;
  line-height: 1.15;
}

.card-unit {
  color: #4a3328;
  font-weight: 900;
}

.card-label {
  color: #2d1f18;
  font-weight: 800;
}

.card-sub {
  color: #8a6b58;
  font-size: 21rpx;
  font-weight: 600;
  margin-top: 8rpx;
  line-height: 1.3;
}

/* 翻页控制行 */
.carousel-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dots {
  display: flex;
  justify-content: center;
  flex: 1 1 auto;
  gap: 10rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(139, 95, 63, 0.24);
  transition: width 180ms ease-out, background 180ms ease-out;
}

.dot.active {
  width: 32rpx;
  background: #ef8178;
}

.carousel-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 58rpx;
  width: 58rpx;
  min-height: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff6e5, #f2c28f);
  color: #7b4930;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow:
    0 10rpx 18rpx rgba(139, 95, 63, 0.13),
    inset 5rpx 6rpx 12rpx rgba(255, 255, 255, 0.54),
    inset -5rpx -7rpx 12rpx rgba(171, 109, 74, 0.16);
}

/* ── 操作按钮 ───────────────────────────────────── */
.actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  flex: 0 0 auto;
  align-self: stretch;
  margin-top: 0;
}

.actions button {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
  min-height: 78rpx;
  padding: 0 16rpx;
  font-size: 25rpx;
  line-height: 1.15;
  white-space: nowrap;
}

.share-button {
  width: 100%;
  min-height: 92rpx;
  font-size: 28rpx;
}

.secondary-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

@media (max-height: 700px) {
  .result-shell {
    gap: 10rpx;
  }

  .summary {
    padding: 24rpx 30rpx 22rpx;
  }

  .eyebrow {
    margin-bottom: 10rpx;
  }

  .calorie-number {
    font-size: 100rpx;
  }

  .badge-row {
    margin-bottom: 10rpx;
  }

  .result-title {
    font-size: 29rpx;
    margin-bottom: 12rpx;
  }

  .equivalent-content {
    gap: 8rpx;
  }

  .equivalent-swiper {
    height: 220rpx;
  }

  .equivalent-card {
    height: 220rpx;
    gap: 24rpx;
    padding: 22rpx 30rpx;
  }

  .icon-well {
    width: 126rpx;
    height: 126rpx;
    border-radius: 28rpx;
  }

  .icon {
    width: 96rpx;
    height: 96rpx;
  }

  .card-number {
    font-size: 68rpx;
  }

  .card-unit,
  .card-label {
    font-size: 30rpx;
  }

  .carousel-arrow {
    flex-basis: 54rpx;
    width: 54rpx;
    min-height: 54rpx;
  }

  .actions {
    gap: 10rpx;
  }

  .share-button {
    min-height: 84rpx;
  }

  .actions button {
    min-height: 72rpx;
  }
}

/* ── 主题色变量（等价卡片背景） ─────────────────── */
.fresh .equivalent-frame {
  background: linear-gradient(145deg, #f5ffe7, #bde8d1);
}

.warm .equivalent-frame {
  background: linear-gradient(145deg, #fff2db, #f6b774);
}

.cocoa .equivalent-frame {
  background: linear-gradient(145deg, #f6e3d1, #c99978);
}

/* ── 海报相关 ───────────────────────────────────── */
.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 360px;
  height: 640px;
}

.poster-preview-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 36rpx;
  background: rgba(47, 36, 29, 0.52);
}

.poster-preview-sheet {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-height: 92vh;
  box-sizing: border-box;
  border-radius: 48rpx;
  background: linear-gradient(145deg, #fff8e8, #f0cda8);
  padding: 28rpx;
  box-shadow:
    0 30rpx 70rpx rgba(47, 36, 29, 0.28),
    inset 10rpx 12rpx 22rpx rgba(255, 255, 255, 0.52),
    inset -10rpx -14rpx 24rpx rgba(168, 99, 68, 0.18);
}

.preview-title {
  color: #3b281d;
  font-size: 30rpx;
  font-weight: 900;
}

.poster-preview-image {
  width: 100%;
  height: 820rpx;
  border-radius: 34rpx;
  background: #fff1dc;
}

.preview-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-save,
.preview-close {
  min-height: 88rpx;
}
