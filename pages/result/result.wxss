.result-page {
  min-height: 100vh;
  padding-top: 0;
}

.result-shell {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

.result-surface {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 34rpx 32rpx 28rpx;
  border: 2rpx solid rgba(95, 61, 49, 0.08);
  border-radius: 32rpx;
  background: linear-gradient(145deg, #fff9f0, #f7dfc7);
  box-shadow: 0 16rpx 34rpx rgba(95, 61, 49, 0.10);
}

.summary-kicker {
  width: fit-content;
  border: 1rpx solid rgba(185, 71, 61, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 249, 240, 0.72);
  color: #8b4f3b;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  padding: 8rpx 16rpx;
}

.calorie-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.calorie-prefix {
  color: #2d1f18;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}

.calorie-number {
  color: #2d1f18;
  font-size: 100rpx;
  font-weight: 900;
  line-height: 0.92;
  letter-spacing: -3rpx;
}

.calorie-unit {
  color: #2d1f18;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.badge-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.result-badge,
.estimate-badge {
  width: fit-content;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  padding: 8rpx 16rpx;
}

.result-badge {
  background: #b9473d;
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(185, 71, 61, 0.18);
}

.estimate-badge {
  border: 1rpx solid rgba(95, 61, 49, 0.10);
  background: #FAEEDA;
  color: #8b5f3f;
}

.result-title {
  color: #2d1f18;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.36;
}

.summary-footer {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(95, 61, 49, 0.08);
}

.drink-name {
  color: #4f342a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
}

.disclaimer {
  color: #8a7566;
  font-size: 23rpx;
  line-height: 1.45;
}

.equivalent-stage {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stage-label {
  color: #4f342a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
  padding-left: 4rpx;
}

.equivalent-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.equivalent-card {
  box-sizing: border-box;
  border: 2rpx solid rgba(185, 118, 78, 0.12);
  border-radius: 28rpx;
  background: #fff9f0;
  color: #2d1f18;
  box-shadow: 0 10rpx 22rpx rgba(95, 61, 49, 0.08);
}

.equivalent-card-large {
  grid-column: span 2;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 178rpx;
  padding: 24rpx 22rpx;
}

.equivalent-card-small {
  grid-column: span 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 10rpx;
  min-height: 150rpx;
  padding: 18rpx 14rpx;
}

.icon-well {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border: 1rpx solid rgba(166, 111, 67, 0.10);
  border-radius: 24rpx;
  background: linear-gradient(145deg, #fff0d2, #f2d1a8);
}

.small-icon-well {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
}

.icon {
  width: 82rpx;
  height: 82rpx;
}

.small-icon {
  width: 42rpx;
  height: 42rpx;
}

.card-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.metric-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 0;
}

.card-number {
  color: #2d1f18;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.card-unit {
  color: #2d1f18;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
}

.card-label {
  display: block;
  color: #5a3a28;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
}

.card-sub {
  display: block;
  color: #8a7566;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-top: 6rpx;
}

.small-metric-row {
  gap: 3rpx;
}

.small-card-number {
  font-size: 30rpx;
  letter-spacing: -1rpx;
}

.small-card-unit {
  font-size: 20rpx;
}

.small-card-label {
  color: #8a5e3f;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
}

.actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 16rpx;
  width: 100%;
  margin-top: 2rpx;
  padding-bottom: 20rpx;
}

.secondary-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
}

.share-button {
  width: 80%;
  justify-self: center;
  min-height: 92rpx;
  margin: 0;
  box-shadow: 0 12rpx 24rpx rgba(185, 71, 61, 0.18);
}

.poster-button,
.recalculate-button {
  width: auto;
  min-width: 0;
  min-height: 78rpx;
  padding: 0 18rpx;
  font-size: 27rpx;
  margin: 0;
}

.secondary-actions .button-secondary {
  border: 2rpx solid #d5cfc8;
  background: rgba(255, 249, 240, 0.56);
  color: #8a8078;
  font-weight: 600;
  box-shadow: none;
}

.error-state {
  margin-top: 20rpx;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 360px;
  height: 640px;
}

.poster-preview-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 36rpx;
  background: rgba(45, 31, 24, 0.58);
}

.poster-preview-sheet {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-height: 92vh;
  box-sizing: border-box;
  padding: 28rpx;
  border: 2rpx solid rgba(95, 61, 49, 0.08);
  border-radius: 40rpx;
  background: #fff9f0;
  box-shadow: 0 30rpx 70rpx rgba(45, 31, 24, 0.28);
}

.preview-title {
  color: #2d1f18;
  font-size: 32rpx;
  font-weight: 800;
}

.poster-preview-image {
  width: 100%;
  height: 760rpx;
  border-radius: 28rpx;
  background: #fff4e5;
}

.preview-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.preview-save {
  min-height: 88rpx;
}

.preview-close {
  min-height: 72rpx;
}