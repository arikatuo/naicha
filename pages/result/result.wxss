.result-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: 0;
}

.result-shell {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 0;
  width: 100%;
  min-height: calc(100vh - 92rpx);
  box-sizing: border-box;
}

.result-surface {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx 32rpx 24rpx;
  border: 2rpx solid rgba(95, 61, 49, 0.08);
  border-radius: 28rpx;
  background: linear-gradient(145deg, #fff9f0, #f7dfc7);
  box-shadow: 0 18rpx 38rpx rgba(95, 61, 49, 0.12);
  margin-bottom: 0;
}

.calorie-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.calorie-prefix {
  color: #2d1f18;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.calorie-number {
  color: #2d1f18;
  font-size: 104rpx;
  font-weight: 900;
  line-height: 0.92;
  letter-spacing: -3rpx;
}

.calorie-unit {
  color: #2d1f18;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}

.badge-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.result-badge,
.estimate-badge {
  width: fit-content;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
  padding: 8rpx 16rpx;
}

.result-badge {
  background: #FAEEDA;
  color: #6a3c2c;
}

.estimate-badge {
  border: 2rpx solid #d5d0ca;
  background: #F1EFE8;
  color: #6f6862;
}

.result-title {
  color: #2d1f18;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.summary-footer {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(95, 61, 49, 0.08);
}

.drink-name {
  color: #4f342a;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.disclaimer {
  color: #6f5d51;
  font-size: 24rpx;
  line-height: 1.45;
}

.equivalent-stage {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 40rpx;
  padding-top: 0;
}

.stage-divider {
  width: 100%;
  height: 1rpx;
  background: rgba(95, 61, 49, 0.10);
  margin-bottom: 8rpx;
}

.stage-label {
  color: #4f342a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
  padding-left: 4rpx;
}

.equivalent-frame {
  overflow: hidden;
  border: 2rpx solid rgba(95, 61, 49, 0.08);
  border-radius: 28rpx;
  background: #fff9f0;
  box-shadow: 0 14rpx 30rpx rgba(95, 61, 49, 0.09);
}

.equivalent-swiper,
.equivalent-card {
  height: 240rpx;
}

.swiper-item-inner {
  display: flex;
  width: 100%;
  height: 100%;
}

.equivalent-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
}

.icon-well {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border: 1rpx solid rgba(166, 111, 67, 0.1);
  border-radius: 24rpx;
  background: linear-gradient(145deg, #fff0d2, #f2d1a8);
}

.icon {
  width: 106rpx;
  height: 106rpx;
}

.card-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.metric-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 0;
}

.card-number {
  flex: 0 0 auto;
  color: #2d1f18;
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1;
}

.metric-copy {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0 4rpx;
  min-width: 0;
}

.card-unit,
.card-label {
  color: #2d1f18;
  font-size: 28rpx;
  line-height: 1.2;
}

.card-unit {
  font-weight: 800;
}

.card-label {
  font-weight: 700;
}

.card-sub {
  color: #6f5d51;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-top: 8rpx;
}

.carousel-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0 16rpx;
}

.carousel-arrow {
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 2rpx solid rgba(185, 71, 61, 0.16);
  border-radius: 999rpx;
  background: #fff9f0;
  color: #6a3c2c;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 8rpx 18rpx rgba(95, 61, 49, 0.08);
}

.carousel-arrow::after {
  border: 0;
}

.carousel-arrow:active {
  opacity: 0.72;
  transform: scale(0.97);
}

.carousel-count {
  color: #6f5d51;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
  width: 100%;
  margin-top: 0;
  padding-bottom: 48rpx;
}

.secondary-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
}

.share-button {
  width: 90%;
  justify-self: center;
  min-height: 88rpx;
  margin: 0;
}

.poster-button,
.recalculate-button {
  width: auto;
  min-width: 0;
  min-height: 80rpx;
  padding: 0 18rpx;
  font-size: 27rpx;
  margin: 0;
}

.secondary-actions .button-secondary {
  border: 2rpx solid #d5cfc8;
  background: transparent;
  color: #8a8078;
  font-weight: 500;
  box-shadow: none;
}

.secondary-actions .button-secondary:active {
  background: rgba(0, 0, 0, 0.03);
  box-shadow: none;
}

.error-state {
  margin-top: 20rpx;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 360px;
  height: 640px;
}

.poster-preview-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 36rpx;
  background: rgba(45, 31, 24, 0.58);
}

.poster-preview-sheet {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-height: 92vh;
  box-sizing: border-box;
  padding: 28rpx;
  border: 2rpx solid rgba(95, 61, 49, 0.08);
  border-radius: 40rpx;
  background: #fff9f0;
  box-shadow: 0 30rpx 70rpx rgba(45, 31, 24, 0.28);
}

.preview-title {
  color: #2d1f18;
  font-size: 32rpx;
  font-weight: 800;
}

.poster-preview-image {
  width: 100%;
  height: 760rpx;
  border-radius: 28rpx;
  background: #fff4e5;
}

.preview-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.preview-save {
  min-height: 88rpx;
}

.preview-close {
  min-height: 72rpx;
}

.fresh .equivalent-frame {
  background: #eef8ea;
}

.warm .equivalent-frame {
  background: #fff0dc;
}

.cocoa .equivalent-frame {
  background: #f3e2d3;
}

@media (max-height: 700px) {
  .result-shell {
    min-height: auto;
  }

  .result-surface {
    gap: 10rpx;
    padding: 24rpx 28rpx 20rpx;
  }

  .calorie-number {
    font-size: 96rpx;
  }

  .equivalent-swiper,
  .equivalent-card {
    height: 220rpx;
  }

  .icon-well {
    width: 116rpx;
    height: 116rpx;
  }

  .icon {
    width: 96rpx;
    height: 96rpx;
  }

  .result-shell {
    gap: 0;
  }

  .equivalent-card {
    padding: 20rpx 24rpx;
  }

  .equivalent-stage {
    margin-top: 32rpx;
    gap: 10rpx;
  }
}
