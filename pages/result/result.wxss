.result-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.summary {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 30rpx;
}

.eyebrow {
  width: fit-content;
  border-radius: 999rpx;
  background: #f6e5ce;
  color: #8b5f3f;
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 18rpx;
}

.result-title {
  font-size: 44rpx;
  font-weight: 900;
}

.calorie-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.calories {
  font-size: 62rpx;
  font-weight: 900;
}

.badge {
  border-radius: 999rpx;
  background: #ead6c1;
  color: #5b3926;
  font-size: 22rpx;
  padding: 8rpx 14rpx;
}

.drink-name,
.disclaimer {
  color: #77675b;
  font-size: 26rpx;
  line-height: 1.5;
}

.cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.equivalent-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 218rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 32rpx rgba(88, 58, 36, 0.08);
}

.icon {
  width: 96rpx;
  height: 96rpx;
}

.card-text {
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.fresh .equivalent-card {
  background: #eef8e9;
}

.warm .equivalent-card {
  background: #ffe8cf;
}

.cocoa .equivalent-card {
  background: #efe0d4;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 360px;
  height: 640px;
}
