.result-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.summary {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-height: 312rpx;
  padding: 34rpx;
  overflow: hidden;
}

.result-toy {
  position: absolute;
  right: -12rpx;
  top: 10rpx;
  width: 206rpx;
  height: 206rpx;
  opacity: 0.92;
  filter: drop-shadow(0 18rpx 18rpx rgba(101, 62, 39, 0.16));
}

.eyebrow {
  width: fit-content;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff6df, #efbf98);
  color: #8b4f3b;
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 18rpx;
  box-shadow:
    0 10rpx 20rpx rgba(139, 95, 63, 0.13),
    inset 5rpx 6rpx 12rpx rgba(255, 255, 255, 0.56),
    inset -5rpx -7rpx 12rpx rgba(174, 101, 73, 0.16);
}

.result-title {
  max-width: 430rpx;
  font-size: 44rpx;
  font-weight: 900;
}

.calorie-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  max-width: 450rpx;
}

.calories {
  font-size: 62rpx;
  font-weight: 900;
}

.badge {
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff5df, #edc295);
  color: #6b3f2a;
  font-size: 22rpx;
  padding: 8rpx 14rpx;
  box-shadow: inset 4rpx 5rpx 10rpx rgba(255, 255, 255, 0.5);
}

.drink-name,
.disclaimer {
  color: #77675b;
  font-size: 26rpx;
  line-height: 1.5;
}

.cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.equivalent-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 232rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 42rpx;
  background: linear-gradient(145deg, #fffaf1, #f6d2a9);
  box-shadow:
    0 22rpx 38rpx rgba(124, 78, 49, 0.16),
    inset 10rpx 12rpx 20rpx rgba(255, 255, 255, 0.55),
    inset -10rpx -14rpx 22rpx rgba(173, 101, 72, 0.16);
}

.icon {
  width: 112rpx;
  height: 112rpx;
}

.card-text {
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.fresh .equivalent-card {
  background: linear-gradient(145deg, #f5ffe7, #bde8d1);
}

.warm .equivalent-card {
  background: linear-gradient(145deg, #fff2db, #f6b774);
}

.cocoa .equivalent-card {
  background: linear-gradient(145deg, #f6e3d1, #c99978);
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 360px;
  height: 640px;
}
