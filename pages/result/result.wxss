.result-page {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 110rpx);
  min-height: 0;
  align-items: stretch;
  justify-content: flex-start;
  overflow: hidden;
}

.result-shell {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  max-height: 100%;
  justify-content: flex-start;
  padding-top: 10rpx;
  box-sizing: border-box;
}

.summary {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  gap: 0;
  border-radius: 38rpx;
  padding: 20rpx 30rpx 18rpx;
}

.eyebrow {
  width: fit-content;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff6df, #efbf98);
  color: #8b4f3b;
  font-size: 22rpx;
  font-weight: 800;
  padding: 7rpx 16rpx;
  box-shadow:
    0 10rpx 20rpx rgba(139, 95, 63, 0.13),
    inset 5rpx 6rpx 12rpx rgba(255, 255, 255, 0.56),
    inset -5rpx -7rpx 12rpx rgba(174, 101, 73, 0.16);
}

.result-title {
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.16;
  margin-bottom: 14rpx;
}

.calorie-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  min-width: 0;
  margin-bottom: 9rpx;
}

.calorie-prefix {
  color: #2d1f18;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.calorie-number {
  color: #2d1f18;
  font-size: 92rpx;
  font-weight: 900;
  line-height: 0.98;
}

.calorie-unit {
  color: #2d1f18;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1;
}

.result-badge,
.estimate-badge {
  width: fit-content;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff5df, #edc295);
  color: #6b3f2a;
  box-shadow: inset 4rpx 5rpx 10rpx rgba(255, 255, 255, 0.5);
}

.result-badge {
  font-size: 21rpx;
  font-weight: 900;
  padding: 6rpx 15rpx;
}

.estimate-badge {
  font-size: 20rpx;
  font-weight: 800;
  padding: 6rpx 13rpx;
}

.badge-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.drink-name {
  color: #4a3328;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
  margin-bottom: 5rpx;
}

.disclaimer {
  color: #77675b;
  font-size: 20rpx;
  line-height: 1.35;
}

.equivalent-stage {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  gap: 9rpx;
  min-height: 0;
}

.stage-label {
  color: #8b5f3f;
  font-size: 22rpx;
  font-weight: 500;
  padding-left: 8rpx;
}

.equivalent-swiper {
  width: 100%;
  height: 248rpx;
  flex: 0 0 auto;
}

.equivalent-frame {
  overflow: hidden;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #fffaf1, #f9d9b4);
  box-shadow:
    0 20rpx 36rpx rgba(124, 78, 49, 0.14),
    inset 10rpx 12rpx 20rpx rgba(255, 255, 255, 0.55),
    inset -10rpx -14rpx 22rpx rgba(173, 101, 72, 0.16);
}

.equivalent-card {
  display: grid;
  grid-template-columns: 122rpx minmax(0, 1fr);
  align-items: center;
  column-gap: 24rpx;
  height: 228rpx;
  box-sizing: border-box;
  padding: 26rpx 32rpx;
}

.icon-well {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #fff8e8, #f0c999);
  box-shadow:
    0 12rpx 24rpx rgba(124, 78, 49, 0.12),
    inset 7rpx 8rpx 15rpx rgba(255, 255, 255, 0.58),
    inset -7rpx -9rpx 16rpx rgba(168, 99, 68, 0.14);
}

.icon {
  width: 70rpx;
  height: 70rpx;
}

.card-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.metric-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.card-number {
  color: #2d1f18;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 0.95;
}

.card-unit {
  color: #4a3328;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.card-label {
  color: #2d1f18;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-top: 7rpx;
}

.card-sub {
  color: #8a6b58;
  font-size: 21rpx;
  font-weight: 800;
  margin-top: 3rpx;
}

.carousel-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.dots {
  display: flex;
  justify-content: center;
  flex: 1 1 auto;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(139, 95, 63, 0.24);
  transition: width 180ms ease-out, background 180ms ease-out;
}

.dot.active {
  width: 38rpx;
  background: #ef8178;
}

.carousel-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 58rpx;
  min-height: 58rpx;
  width: 58rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff6e5, #f2c28f);
  color: #7b4930;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow:
    0 10rpx 18rpx rgba(139, 95, 63, 0.13),
    inset 5rpx 6rpx 12rpx rgba(255, 255, 255, 0.54),
    inset -5rpx -7rpx 12rpx rgba(171, 109, 74, 0.16);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 0 0 auto;
  align-self: stretch;
  margin-top: 4rpx;
}

.actions button {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
  min-height: 78rpx;
  padding: 0 16rpx;
  font-size: 25rpx;
  line-height: 1.15;
  white-space: nowrap;
}

.share-button {
  width: 100%;
  min-height: 86rpx;
  font-size: 28rpx;
}

.secondary-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.fresh .equivalent-frame {
  background: linear-gradient(145deg, #f5ffe7, #bde8d1);
}

.warm .equivalent-frame {
  background: linear-gradient(145deg, #fff2db, #f6b774);
}

.cocoa .equivalent-frame {
  background: linear-gradient(145deg, #f6e3d1, #c99978);
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 360px;
  height: 640px;
}

.poster-preview-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 36rpx;
  background: rgba(47, 36, 29, 0.52);
}

.poster-preview-sheet {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-height: 92vh;
  box-sizing: border-box;
  border-radius: 48rpx;
  background: linear-gradient(145deg, #fff8e8, #f0cda8);
  padding: 28rpx;
  box-shadow:
    0 30rpx 70rpx rgba(47, 36, 29, 0.28),
    inset 10rpx 12rpx 22rpx rgba(255, 255, 255, 0.52),
    inset -10rpx -14rpx 24rpx rgba(168, 99, 68, 0.18);
}

.preview-title {
  color: #3b281d;
  font-size: 30rpx;
  font-weight: 900;
}

.poster-preview-image {
  width: 100%;
  height: 820rpx;
  border-radius: 34rpx;
  background: #fff1dc;
}

.preview-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-save,
.preview-close {
  min-height: 88rpx;
}
