.result-page { min-height: 100vh; padding-top: 8rpx; padding-bottom: calc(260rpx + env(safe-area-inset-bottom)); }

.result-shell { display: flex; flex-direction: column; gap: 28rpx; width: 100%; box-sizing: border-box; padding-bottom: 32rpx; }

/* ---------- 结果主卡片 ---------- */
.result-surface {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 32rpx;
  border-radius: var(--r-lg);
  background: var(--surface-soft);
}

.summary-topline { display: flex; align-items: center; gap: 12rpx; }
.result-badge, .estimate-badge { width: fit-content; padding: 8rpx 18rpx; border-radius: var(--r-pill); font-size: var(--fs-cap); font-weight: var(--fw-strong); line-height: 1.2; }
.result-badge { background: var(--primary); color: #fff; }
.estimate-badge { background: var(--surface); color: var(--text-2); }

.calorie-row { display: flex; align-items: baseline; gap: 10rpx; }
.calorie-prefix { color: var(--text); font-size: 34rpx; line-height: 1; }
.calorie-number { color: var(--text); font-size: 100rpx; font-weight: var(--fw-strong); line-height: 0.95; letter-spacing: -2rpx; }
.calorie-unit { color: var(--text-2); font-size: 30rpx; line-height: 1; }

.result-title { color: var(--text); font-size: 32rpx; font-weight: var(--fw-strong); line-height: 1.4; }

.summary-footer { display: flex; flex-direction: column; gap: 6rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(120, 70, 50, 0.1); }
.drink-name { color: var(--text); font-size: 26rpx; font-weight: var(--fw-strong); line-height: 1.4; }
.disclaimer { color: var(--text-3); font-size: 23rpx; line-height: 1.45; }

/* ---------- 相当于：一张大卡片 + 四张可点的小卡 ---------- */
.equivalent-stage { display: flex; flex-direction: column; gap: 18rpx; }
.stage-head { display: flex; align-items: baseline; justify-content: space-between; padding: 0 4rpx; }
.stage-label { color: var(--text); font-size: 30rpx; font-weight: var(--fw-strong); line-height: 1.3; }
.stage-hint { color: var(--text-3); font-size: 22rpx; }

.equivalent-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  color: var(--text);
}

.icon-well { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 168rpx; height: 168rpx; border-radius: var(--r-md); background: var(--surface-soft); }
.icon { width: 128rpx; height: 128rpx; }
.card-body { display: flex; flex: 1; flex-direction: column; justify-content: center; min-width: 0; }
.metric-row { display: flex; align-items: baseline; gap: 8rpx; min-width: 0; }
.card-number { color: var(--text); font-size: 92rpx; font-weight: var(--fw-strong); line-height: 1; letter-spacing: -2rpx; }
.card-unit { color: var(--text); font-size: 34rpx; font-weight: var(--fw-strong); line-height: 1.2; }
.card-label { display: block; margin-top: 10rpx; color: var(--text); font-size: 30rpx; font-weight: var(--fw-strong); line-height: 1.25; }
.card-sub { display: block; margin-top: 6rpx; color: var(--text-3); font-size: 24rpx; line-height: 1.35; }

.equivalent-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.equivalent-tile { display: flex; align-items: center; gap: 16rpx; min-height: 112rpx; box-sizing: border-box; padding: 14rpx 20rpx; border: 1rpx solid var(--line); border-radius: var(--r-md); background: var(--surface); }
.tile-icon { flex: 0 0 72rpx; width: 72rpx; height: 72rpx; }
.tile-copy { display: flex; flex: 1; flex-direction: column; gap: 4rpx; min-width: 0; }
.tile-metric { display: flex; align-items: baseline; gap: 6rpx; }
.tile-number { color: var(--text); font-size: 36rpx; font-weight: var(--fw-strong); line-height: 1.1; }
.tile-unit { color: var(--text-2); font-size: 22rpx; }
.tile-label { overflow: hidden; color: var(--text-2); font-size: 23rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }

/* ---------- 操作：次要按钮在内容里，主操作固定在屏幕底部 ---------- */
.secondary-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.secondary-actions.shared-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.secondary-actions .button-secondary { min-height: 80rpx; padding: 0 8rpx; font-size: 25rpx; font-weight: var(--fw-strong); box-shadow: none; }

/* 分享必须用 button 的 open-type，这里把透明按钮盖在 view 上面 */
.share-slot { position: relative; }
.share-slot .button-secondary { width: 100%; }
.share-overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: auto; max-width: none; min-width: 0; height: 100%; margin: 0; padding: 0; border: 0; border-radius: var(--r-pill); background: transparent; opacity: 0; }
.share-overlay::after { border: 0; }

.actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--surface);
}

.date-row { display: flex; align-items: center; gap: 10rpx; }
.date-row-label { margin-right: 4rpx; color: var(--text-2); font-size: 26rpx; }
.date-chip { display: flex; align-items: center; justify-content: center; min-height: 64rpx; box-sizing: border-box; padding: 0 22rpx; border: 2rpx solid var(--line); border-radius: var(--r-pill); background: var(--surface); color: var(--text-2); font-size: 25rpx; line-height: 1; }
.date-chip.active { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); font-weight: var(--fw-strong); }

.save-record-button, .own-drink-button { width: 100%; min-height: 92rpx; }

.error-state { margin-top: 20rpx; }

/* ---------- 分享图预览 ---------- */
.poster-canvas { position: fixed; left: -9999rpx; top: -9999rpx; width: 360px; height: 640px; }

.poster-preview-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 36rpx; background: rgba(45, 31, 24, 0.58); }
.poster-preview-sheet { display: flex; flex-direction: column; gap: 20rpx; width: 100%; max-height: 92vh; box-sizing: border-box; padding: 28rpx; border-radius: var(--r-lg); background: var(--bg); }
.preview-title { color: var(--text); font-size: 32rpx; font-weight: var(--fw-strong); }
.poster-preview-image { width: 100%; height: 760rpx; border-radius: var(--r-md); background: var(--bg); }
.preview-actions { display: flex; flex-direction: column; gap: 8rpx; }
.preview-save { min-height: 88rpx; }
.preview-close { min-height: 80rpx; }
