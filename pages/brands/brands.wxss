.section-head {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 34rpx;
}

.eyebrow {
  width: fit-content;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff6df, #efbf98);
  color: #8b4f3b;
  font-size: 24rpx;
  font-weight: 800;
  padding: 10rpx 20rpx;
  box-shadow:
    0 10rpx 20rpx rgba(139, 95, 63, 0.13),
    inset 5rpx 6rpx 12rpx rgba(255, 255, 255, 0.56),
    inset -5rpx -7rpx 12rpx rgba(174, 101, 73, 0.16);
}

.title {
  font-size: 48rpx;
  font-weight: 900;
}

.subtitle,
.disclaimer {
  color: #7f7168;
  font-size: 24rpx;
  line-height: 1.5;
}

.brand-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.brand-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  width: 100%;
  min-height: 178rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #fffdf6, #f4d7b8);
  color: #3b281d;
  margin: 0;
  padding: 22rpx;
  text-align: left;
  box-shadow:
    0 22rpx 38rpx rgba(124, 78, 49, 0.18),
    inset 10rpx 12rpx 20rpx rgba(255, 255, 255, 0.56),
    inset -10rpx -14rpx 22rpx rgba(173, 101, 72, 0.18);
  transition: transform 180ms ease-out, box-shadow 180ms ease-out;
}

.brand-card:nth-child(2n) {
  background: linear-gradient(145deg, #f9fff2, #d5ead6);
}

.brand-card::after {
  border: 0;
}

.brand-card:active {
  opacity: 0.98;
  transform: scale(0.965) translateY(4rpx);
  box-shadow:
    0 8rpx 16rpx rgba(124, 78, 49, 0.12),
    inset 10rpx 12rpx 20rpx rgba(111, 66, 43, 0.18),
    inset -8rpx -10rpx 18rpx rgba(255, 246, 221, 0.28);
}

.brand-logo {
  width: 156rpx;
  height: 74rpx;
  margin-left: -6rpx;
  filter: drop-shadow(0 8rpx 10rpx rgba(77, 48, 34, 0.13));
}

.brand-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 0;
}

.brand-name {
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.25;
}

.brand-hint {
  align-self: flex-end;
  border-radius: 999rpx;
  background: rgba(255, 250, 241, 0.58);
  color: #7d4e35;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  padding: 9rpx 14rpx;
  box-shadow:
    inset 4rpx 5rpx 9rpx rgba(255, 255, 255, 0.62),
    inset -4rpx -5rpx 9rpx rgba(130, 81, 51, 0.12);
}

.soft-note {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 36rpx;
  border-radius: 999rpx;
  background: rgba(255, 250, 241, 0.72);
  color: #8a7b70;
  font-size: 23rpx;
  line-height: 1.45;
  padding: 16rpx 20rpx;
  box-shadow: inset 5rpx 7rpx 14rpx rgba(128, 84, 54, 0.1);
}

.soft-note image {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
}
