.section-head {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 34rpx;
}

.eyebrow {
  width: fit-content;
  border-radius: 999rpx;
  background: #f6e5ce;
  color: #8b5f3f;
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 18rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 900;
}

.subtitle,
.disclaimer {
  color: #7f7168;
  font-size: 24rpx;
  line-height: 1.5;
}

.brand-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.brand-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 156rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #fffdf8, #f3e2cb);
  color: #3b281d;
  padding: 26rpx;
  text-align: left;
  box-shadow: 0 12rpx 30rpx rgba(88, 58, 36, 0.08);
}

.brand-card::after {
  border: 0;
}

.brand-card:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.brand-name {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.brand-hint {
  color: #8b5f3f;
  font-size: 22rpx;
  font-weight: 700;
}

.disclaimer {
  display: block;
  margin-top: 36rpx;
  text-align: center;
}
