.section-head {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 34rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
}

.subtitle {
  color: #6f5d51;
  font-size: 26rpx;
  line-height: 1.55;
}

.brand-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.brand-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(95, 61, 49, 0.08);
  border-radius: 28rpx;
  background: #fff9f0;
  color: #3b281d;
  margin: 0;
  padding: 18rpx;
  text-align: center;
  box-shadow: 0 10rpx 22rpx rgba(124, 78, 49, 0.07);
  transition: transform 80ms ease-out, box-shadow 80ms ease-out, background 80ms ease-out;
}

.brand-card::after {
  border: 0;
}

.brand-card:active {
  background: #EDE8E0;
  transform: scale(0.97);
  box-shadow: 0 6rpx 14rpx rgba(124, 78, 49, 0.06);
}

.brand-logo-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 120rpx;
  border-radius: 20rpx;
  background: rgba(255, 250, 243, 0.96);
  border: 2rpx solid rgba(95, 61, 49, 0.05);
  overflow: hidden;
}

.brand-logo {
  display: block;
  width: 160rpx;
  height: 100rpx;
}

.brand-logo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F1EFE8;
  color: #5F5E5A;
  font-size: 48rpx;
  font-weight: 800;
}

.brand-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 100%;
  min-width: 0;
  padding-bottom: 4rpx;
}

.brand-name,
.brand-subtitle {
  display: block;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-align: center;
  text-overflow: ellipsis;
}

.brand-name {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.18;
}

.brand-subtitle {
  color: #6f5d51;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.35;
}

.empty-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

.empty-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx;
}

.empty-action {
  width: 100%;
}

.soft-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 48rpx;
  border-top: 1rpx solid #e0dcd6;
  border-radius: 0 0 28rpx 28rpx;
  background: rgba(255, 249, 241, 0.88);
  color: #6f5d51;
  font-size: 24rpx;
  line-height: 1.45;
  padding: 20rpx 20rpx 16rpx;
  box-shadow: 0 8rpx 18rpx rgba(128, 84, 54, 0.06);
}

.soft-note image {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  margin-top: 2rpx;
}

.soft-note-copy {
  display: block;
  flex: 1;
  min-width: 0;
  white-space: normal;
  overflow-wrap: break-word;
}

.quick-section { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 34rpx; }
.quick-title, .brand-section-title { display: block; color: #5f3d31; font-size: 27rpx; font-weight: 800; }
.brand-section-title { margin-bottom: 18rpx; }
.quick-list { display: flex; flex-direction: column; gap: 12rpx; }
.quick-drink { display: flex; align-items: center; gap: 18rpx; width: 100%; min-height: 112rpx; box-sizing: border-box; padding: 14rpx 20rpx; margin: 0; border: 2rpx solid rgba(95, 61, 49, 0.08); border-radius: 24rpx; background: #fff9f0; text-align: left; }
.quick-drink::after { border: 0; }
.quick-drink image { flex: 0 0 76rpx; width: 76rpx; height: 76rpx; }
.quick-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4rpx; }
.quick-name { overflow: hidden; color: #2d1f18; font-size: 27rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.quick-brand { color: #8a7566; font-size: 22rpx; }
.quick-chevron { color: #a94338; font-size: 42rpx; }

.custom-fallback {
  width: 100%;
  min-height: 80rpx;
  margin: 30rpx 0 0;
  border: 0;
  background: transparent;
  color: #8b4f3b;
  font-size: 26rpx;
  font-weight: 700;
}
.custom-fallback::after { border: 0; }
