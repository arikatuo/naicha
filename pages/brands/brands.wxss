.section-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 900;
}

.subtitle,
.disclaimer {
  color: #7f7168;
  font-size: 24rpx;
  line-height: 1.5;
}

.brand-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.brand-card {
  min-height: 128rpx;
  border-radius: 18rpx;
  background: #f3e4d3;
  color: #3b281d;
  font-size: 30rpx;
  font-weight: 800;
}

.disclaimer {
  display: block;
  margin-top: 36rpx;
  text-align: center;
}
