<view class="page">
  <view class="section-head">
    <text class="title">选一个品牌</text>
    <text class="subtitle">不使用官方数据，所有结果都是趣味估算。</text>
  </view>

  <view class="brand-grid">
    <button
      wx:for="{{brands}}"
      wx:key="id"
      class="brand-card"
      data-id="{{item.id}}"
      bindtap="openBrand"
    >
      {{item.name}}
    </button>
  </view>

  <text class="disclaimer">热量为估算值，非品牌官方数据，仅供趣味参考。</text>
</view>
