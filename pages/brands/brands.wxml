<view class="page">
  <view class="section-head">
    <text class="title">选一杯你喝过的</text>
    <text class="subtitle">可以从常见饮品开始，也可以按品牌找。</text>
  </view>

  <view wx:if="{{quickDrinks.length}}" class="quick-section">
    <text class="quick-title">常见饮品 · 快速开始</text>
    <view class="quick-list">
      <button wx:for="{{quickDrinks}}" wx:key="id" class="quick-drink" data-id="{{item.id}}" bindtap="openQuickDrink" aria-label="选择{{item.brandName}}{{item.name}}">
        <image src="{{item.icon}}" mode="aspectFit" aria-hidden="true"></image>
        <view class="quick-copy"><text class="quick-name">{{item.name}}</text><text class="quick-brand">{{item.brandName}}</text></view>
        <text class="quick-chevron" aria-hidden="true">›</text>
      </button>
    </view>
  </view>

  <text class="brand-section-title">按品牌找</text>

  <view wx:if="{{hasBrands}}" class="brand-grid">
    <button
      wx:for="{{brands}}"
      wx:key="id"
      class="brand-card"
      data-id="{{item.id}}"
      bindtap="openBrand"
      aria-label="查看{{item.name}}热门款"
    >
      <view class="brand-logo-panel">
        <image
          wx:if="{{!item.logoFailed}}"
          class="brand-logo"
          src="{{item.logo}}"
          mode="aspectFit"
          binderror="onLogoError"
          data-index="{{index}}"
          aria-hidden="true"
        ></image>
        <view wx:else class="brand-logo-fallback" aria-hidden="true">
          <text>{{item.firstChar}}</text>
        </view>
      </view>
      <view class="brand-meta">
        <text class="brand-name">{{item.name}}</text>
        <text class="brand-subtitle">{{item.subtitle}}</text>
      </view>
    </button>
  </view>
  <view wx:else class="empty-state">
    <view class="surface empty-panel">
      <text class="state-title">品牌列表还在赶来路上</text>
      <text class="state-copy">可能是数据没刷新出来。重新试试，或者先回首页从别的入口开始。</text>
      <view class="empty-actions">
        <button class="button-primary empty-action" bindtap="reloadBrands" aria-label="重新加载品牌列表">重新试试</button>
        <button class="button-secondary empty-action" bindtap="goHome" aria-label="返回首页">回到首页</button>
      </view>
    </view>
  </view>

  <button class="custom-fallback" bindtap="goCustom">没找到？自己搭一杯</button>

  <view class="soft-note">
    <image src="/assets/icons/pearls.png" mode="aspectFit" aria-hidden="true"></image>
    <text class="soft-note-copy">热量为估算值，非品牌官方数据，仅供趣味参考。</text>
  </view>
</view>
