page {
  background: #fff1dc;
  color: #35231c;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 32rpx 68rpx;
}

.muted {
  color: #77695f;
}

.button-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 108rpx;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #ffb66d, #ef7f75);
  color: #fffaf1;
  box-shadow:
    0 22rpx 42rpx rgba(198, 92, 63, 0.28),
    inset 10rpx 12rpx 22rpx rgba(255, 236, 196, 0.48),
    inset -10rpx -14rpx 24rpx rgba(161, 70, 55, 0.22);
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1;
  transition: transform 180ms ease-out, box-shadow 180ms ease-out, opacity 180ms ease-out;
}

.button-primary::after,
.button-secondary::after {
  border: 0;
}

.button-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff8e8, #f6d7ad);
  color: #5d3a2b;
  box-shadow:
    0 18rpx 36rpx rgba(139, 95, 63, 0.16),
    inset 8rpx 10rpx 18rpx rgba(255, 255, 255, 0.68),
    inset -8rpx -12rpx 20rpx rgba(186, 133, 88, 0.18);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
  transition: transform 180ms ease-out, box-shadow 180ms ease-out, opacity 180ms ease-out;
}

.button-primary:active,
.button-secondary:active {
  opacity: 0.96;
  transform: scale(0.965) translateY(4rpx);
  box-shadow:
    0 8rpx 16rpx rgba(139, 95, 63, 0.14),
    inset 10rpx 12rpx 22rpx rgba(115, 64, 42, 0.2),
    inset -8rpx -10rpx 18rpx rgba(255, 246, 222, 0.28);
}

.surface {
  border-radius: 44rpx;
  background: linear-gradient(145deg, #fffaf1, #f9d9b4);
  box-shadow:
    0 26rpx 50rpx rgba(125, 78, 49, 0.18),
    inset 12rpx 14rpx 24rpx rgba(255, 255, 255, 0.62),
    inset -12rpx -16rpx 28rpx rgba(188, 126, 82, 0.18);
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff6e5, #f3cba5);
  color: #684330;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow:
    0 10rpx 18rpx rgba(139, 95, 63, 0.13),
    inset 5rpx 7rpx 12rpx rgba(255, 255, 255, 0.55),
    inset -5rpx -7rpx 12rpx rgba(171, 109, 74, 0.16);
}

.clay-chip {
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fbe3b8, #eeb28e);
  box-shadow:
    0 10rpx 20rpx rgba(126, 78, 49, 0.14),
    inset 5rpx 6rpx 12rpx rgba(255, 255, 255, 0.48),
    inset -5rpx -7rpx 12rpx rgba(172, 93, 68, 0.16);
}

.clay-pressed {
  box-shadow:
    inset 8rpx 10rpx 18rpx rgba(109, 65, 43, 0.2),
    inset -8rpx -10rpx 18rpx rgba(255, 243, 211, 0.36);
}
