page {
  background: #fff4e5;
  color: #2d1f18;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
}

.muted {
  color: #6f5d51;
}

.button-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #b9473d, #a94338);
  color: #fff;
  box-shadow: 0 16rpx 30rpx rgba(169, 67, 56, 0.24);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
  transition: transform 180ms ease-out, box-shadow 180ms ease-out, opacity 180ms ease-out;
}

.button-primary::after,
.button-secondary::after,
.button-text::after {
  border: 0;
}

.button-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 92rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 28rpx;
  border: 2rpx solid rgba(185, 71, 61, 0.16);
  border-radius: 999rpx;
  background: #fff9f0;
  color: #5f3d31;
  box-shadow: 0 10rpx 22rpx rgba(95, 61, 49, 0.09);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
  transition: transform 180ms ease-out, box-shadow 180ms ease-out, opacity 180ms ease-out;
}

.button-primary:active,
.button-secondary:active {
  opacity: 0.94;
  transform: scale(0.98) translateY(2rpx);
  box-shadow: 0 6rpx 14rpx rgba(95, 61, 49, 0.12);
}

.surface {
  border: 2rpx solid rgba(95, 61, 49, 0.08);
  border-radius: 28rpx;
  background: #fff9f0;
  box-shadow: 0 14rpx 32rpx rgba(95, 61, 49, 0.09);
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #f8e4cf;
  color: #5f3d31;
  font-size: 24rpx;
  font-weight: 700;
}

.clay-chip {
  border-radius: 999rpx;
  background: #f4d8bd;
  box-shadow: 0 8rpx 18rpx rgba(95, 61, 49, 0.08);
}

.clay-pressed {
  background: #6a3c2c;
  color: #fff;
  box-shadow: none;
}

.button-text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  background: transparent;
  color: #6a3c2c;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.button-text:active {
  opacity: 0.64;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.page-title {
  color: #2d1f18;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.page-subtitle {
  color: #6f5d51;
  font-size: 26rpx;
  line-height: 1.5;
}

.empty-state,
.error-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 18rpx;
  padding: 36rpx;
}

.state-title {
  color: #2d1f18;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
}

.state-copy {
  color: #6f5d51;
  font-size: 26rpx;
  line-height: 1.55;
}
