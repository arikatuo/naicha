/* ============ 设计变量（全局唯一来源，页面样式一律引用这里） ============ */
page {
  /* 色彩：暖白底 + 单一强调色 */
  --bg: #fbf8f3;
  --surface: #ffffff;
  --surface-soft: #f8ebde;
  --primary: #b9473d;
  --primary-soft: #f9e7e2;
  --text: #2d1f18;
  --text-2: #75625a;
  --text-3: #857468;
  --line: #efe6dd;
  /* 热量分档：轻松 / 适中 / 偏高 */
  --heat-1: #f0b48a;
  --heat-2: #e08a5a;
  --heat-3: #b9473d;
  /* 圆角 */
  --r-sm: 16rpx;
  --r-md: 24rpx;
  --r-lg: 32rpx;
  --r-pill: 999rpx;
  /* 字号与字重：只用 400 / 600 两档字重 */
  --fs-title: 44rpx;
  --fs-h2: 32rpx;
  --fs-body: 28rpx;
  --fs-cap: 24rpx;
  --fw: 400;
  --fw-strong: 600;
  /* 阴影 */
  --shadow-card: 0 8rpx 28rpx rgba(120, 70, 50, 0.06);
  --shadow-cta: 0 12rpx 28rpx rgba(185, 71, 61, 0.22);

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--fs-body);
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
}

.muted {
  color: var(--text-2);
}

/* ---------- 按钮：一个主按钮、一个次按钮、一个文字按钮 ---------- */
.button-primary,
.button-secondary,
.button-text {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  line-height: 1.2;
  white-space: nowrap;
}

.button-primary::after,
.button-secondary::after,
.button-text::after {
  border: 0;
}

.button-primary {
  width: 100%;
  min-height: 96rpx;
  padding: 0 32rpx;
  border: 0;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #fff;
  box-shadow: var(--shadow-cta);
  font-size: 30rpx;
  font-weight: var(--fw-strong);
}

.is-disabled {
  opacity: 0.5;
  box-shadow: none;
}

.button-secondary {
  width: 100%;
  min-height: 88rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--r-pill);
  background: var(--surface);
  color: var(--text);
  font-size: 28rpx;
  font-weight: var(--fw-strong);
}

.button-text {
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 0;
  background: transparent;
  color: var(--text-2);
  font-size: 28rpx;
  font-weight: var(--fw-strong);
}

/* ---------- 容器与小件 ---------- */
.surface {
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--shadow-card);
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  box-sizing: border-box;
  border-radius: var(--r-pill);
  background: var(--surface-soft);
  color: var(--text);
  font-size: var(--fs-cap);
  font-weight: var(--fw-strong);
}

.clay-chip {
  border-radius: var(--r-pill);
  background: var(--surface-soft);
}

.clay-pressed {
  background: var(--primary);
  color: #fff;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.page-title {
  color: var(--text);
  font-size: var(--fs-title);
  font-weight: var(--fw-strong);
  line-height: 1.2;
}

.page-subtitle {
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.5;
}

.empty-state,
.error-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 18rpx;
  padding: 36rpx;
}

.state-title {
  color: var(--text);
  font-size: var(--fs-h2);
  font-weight: var(--fw-strong);
  line-height: 1.25;
}

.state-copy {
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.55;
}
